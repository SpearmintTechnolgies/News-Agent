{
  "env": {
    "GOOGLE_CLOUD_PROJECT": "YOUR_GCP_PROJECT_ID",
    "GOOGLE_CLOUD_LOCATION": "us-central1",
    "BIFROST_BASE_URL": "http://YOUR_BIFROST_HOST:8888/v1",
    "AWS_BEARER_TOKEN_BEDROCK": "YOUR_AWS_BEDROCK_BEARER_TOKEN"
  },
  "agents": {
    "defaults": {
      "workspace": "/home/USER/.openclaw/workspace",
      "models": {},
      "thinkingDefault": "medium",
      "model": {
        "primary": "local-bifrost/gemini-3.5-flash",
        "fallbacks": [
          "local-bifrost/gemini-3.1-pro-preview",
          "local-bifrost/gemini-2.5-pro",
          "local-bifrost/gemini-2.5-flash"
        ]
      },
      "contextInjection": "always",
      "bootstrapMaxChars": 50000,
      "bootstrapTotalMaxChars": 300000
    },
    "list": [
      {
        "id": "main",
        "workspace": "/home/USER/.openclaw/workspace",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        }
      },
      {
        "id": "orchestrator",
        "workspace": "/home/USER/.openclaw/workspace-orchestrator",
        "model": {
          "primary": "local-bifrost/gemini-3.1-pro-preview"
        },
        "subagents": {
          "allowAgents": [
            "researcher",
            "writer",
            "chart-generator",
            "creator",
            "publisher",
            "wp-publisher"
          ]
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": [
            "agents_list",
            "nodes",
            "message",
            "gateway",
            "browser",
            "canvas",
            "tts",
            "sessions_spawn",
            "sessions_yield",
            "subagents"
          ]
        }
      },
      {
        "id": "researcher",
        "workspace": "/home/USER/.openclaw/workspace-researcher",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        },
        "tools": {
          "deny": [
            "web_search",
            "web_fetch"
          ]
        }
      },
      {
        "id": "writer",
        "workspace": "/home/USER/.openclaw/workspace-writer",
        "model": {
          "primary": "local-bifrost/gemini-2.5-pro"
        }
      },
      {
        "id": "creator",
        "workspace": "/home/USER/.openclaw/workspace-creator",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        }
      },
      {
        "id": "publisher",
        "workspace": "/home/USER/.openclaw/workspace-publisher",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        }
      },
      {
        "id": "wp-publisher",
        "workspace": "/home/USER/.openclaw/workspace-wp-publisher",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        }
      },
      {
        "id": "chart-generator",
        "workspace": "/home/USER/.openclaw/workspace-chart-generator",
        "model": {
          "primary": "local-bifrost/gemini-3.5-flash"
        }
      }
    ]
  },
  "models": {
    "mode": "replace",
    "providers": {
      "local-bifrost": {
        "baseUrl": "http://YOUR_BIFROST_HOST:8888/v1",
        "api": "openai-completions",
        "apiKey": "dummy",
        "models": [
          {
            "id": "gemini-3.1-pro-preview",
            "name": "Gemini 3.1 Pro (Bifrost Vertex)",
            "contextWindow": 200000,
            "maxTokens": 32768,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "reasoning": true
          },
          {
            "id": "gemini-3.5-flash",
            "name": "Gemini 3.5 Flash (Bifrost Vertex)",
            "contextWindow": 128000,
            "maxTokens": 16384,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "reasoning": true
          },
          {
            "id": "gemini-2.5-pro",
            "name": "Gemini 2.5 Pro (Bifrost Vertex)",
            "contextWindow": 200000,
            "maxTokens": 32768,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "reasoning": true
          },
          {
            "id": "gemini-2.5-flash",
            "name": "Gemini 2.5 Flash (Bifrost Vertex)",
            "contextWindow": 128000,
            "maxTokens": 16384,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "reasoning": true
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "YOUR_OPENCLAW_GATEWAY_AUTH_TOKEN"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": { "mode": "off", "resetOnExit": false },
    "controlUi": { "allowInsecureAuth": true },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": { "dmScope": "per-channel-peer" },
  "tools": {
    "profile": "coding",
    "exec": { "security": "full", "ask": "off" },
    "web": {
      "search": { "provider": "searxng", "enabled": true, "openaiCodex": {} },
      "fetch": { "enabled": true }
    }
  },
  "auth": {
    "profiles": {
      "openrouter:default": { "provider": "openrouter", "mode": "api_key" }
    }
  },
  "plugins": {
    "entries": {
      "searxng": {
        "enabled": true,
        "config": { "webSearch": { "baseUrl": "https://paulgo.io" } }
      },
      "amazon-bedrock": { "enabled": false },
      "openrouter": { "enabled": true },
      "browser": { "enabled": true }
    }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": { "enabled": true },
        "boot-md": { "enabled": true }
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "defaultAccount": "news",
      "botToken": "YOUR_TELEGRAM_NEWS_BOT_TOKEN_FROM_BOTFATHER",
      "groupPolicy": "open",
      "groups": {
        "YOUR_TELEGRAM_NEWS_GROUP_ID": { "requireMention": true },
        "*": { "requireMention": true }
      },
      "accounts": {
        "news": {
          "name": "News Agent",
          "botToken": "YOUR_TELEGRAM_NEWS_BOT_TOKEN_FROM_BOTFATHER",
          "groupPolicy": "open",
          "groups": {
            "YOUR_TELEGRAM_NEWS_GROUP_ID": { "requireMention": true },
            "*": { "requireMention": true }
          }
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "orchestrator",
      "match": {
        "channel": "telegram",
        "accountId": "news",
        "peer": { "kind": "group", "id": "YOUR_TELEGRAM_NEWS_GROUP_ID" }
      }
    },
    {
      "agentId": "orchestrator",
      "match": { "channel": "telegram", "accountId": "news" }
    }
  ],
  "skills": {
    "install": { "nodeManager": "npm" }
  }
}
