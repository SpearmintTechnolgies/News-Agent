# V2 starts with NO production credentials.
# Do not put Aadi or production bot credentials here.

NEWSAGENT_ENV=dev

# Optional later:
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Test-only destinations later:
TEST_TELEGRAM_BOT_TOKEN=
TEST_TELEGRAM_CHAT_ID=

NEWSAGENT_V2_TELEGRAM_BOT_TOKEN=
# One chat, or several separated by commas. All of them can operate the bot and receive cards.
NEWSAGENT_V2_TELEGRAM_TEST_CHAT_ID=

# V5 writer: fail-closed Kimi configuration (canonical runtime)
NEWSAGENT_V2_V4_WRITER_PROVIDER=kimi
NEWSAGENT_V2_V4_ALLOW_KIMI=true
# KIMI_API_KEY=

# Set true to disable automatic generation (manual GENERATE NOW confirmation)
NEWSAGENT_V5_CONTROLLED_E2E=

# Set true to skip live RSS source expansion (offline/unit tests)
NEWSAGENT_V5_SKIP_SOURCE_EXPANSION=

# Max age (hours) for /make discovery + source expansion (default 24)
NEWSAGENT_V5_MAX_AGE_HOURS=24

# Published list prices so the review card can show a dollar total. US Bedrock Kimi K3 standard.
NEWSAGENT_V2_KIMI_PRICING_VERIFIED=true
NEWSAGENT_V2_KIMI_INPUT_USD_PER_MTOK=3.30
NEWSAGENT_V2_KIMI_OUTPUT_USD_PER_MTOK=16.50
NEWSAGENT_V2_KIMI_PRICING_SOURCE=AWS Bedrock Kimi K3 US standard

# Gemini 3.1 Flash Image on Vertex, global list price. Input $0.50/M, image output $60/M.
NEWSAGENT_V2_VERTEX_PRICING_VERIFIED=true
NEWSAGENT_V2_VERTEX_INPUT_USD_PER_MTOK=0.50
NEWSAGENT_V2_VERTEX_IMAGE_OUTPUT_USD_PER_MTOK=60

NEWSAGENT_V2_WORDPRESS_BASE_URL=
NEWSAGENT_V2_WORDPRESS_USERNAME=
NEWSAGENT_V2_WORDPRESS_APP_PASSWORD=

# Cloudflare Workers AI (optional; live image generation only).
NEWSAGENT_V2_CLOUDFLARE_ACCOUNT_ID=
NEWSAGENT_V2_CLOUDFLARE_API_TOKEN=
NEWSAGENT_V2_GEMINI_API_KEY=
