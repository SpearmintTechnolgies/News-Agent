"""V5 Telegram Bot - FIXED with proper polling loop.

This version loops continuously using integration.run_once().
"""

from __future__ import annotations

import sys
import os

sys.path.insert(0, "src")

from newsagent_v2.telegram.config import load_telegram_config
from newsagent_v2.telegram.client import TelegramTestClient
from newsagent_v2.telegram.live_transport import create_live_transport
from newsagent_v2.telegram.listener_v5 import V5TelegramIntegration


def main() -> int:
    print("=" * 60)
    print("V5 Telegram Bot Starting (FIXED)")
    print("=" * 60)
    
    token = os.environ.get("NEWSAGENT_V2_TELEGRAM_BOT_TOKEN", "").strip()
    chat_id = os.environ.get("NEWSAGENT_V2_TELEGRAM_TEST_CHAT_ID", "").strip()
    
    if not token or not chat_id:
        print("[ERROR] Missing credentials")
        return 1
    
    print("Token: SET")
    print(f"Chat ID: {chat_id}")
    print()
    
    # Setup
    telegram_config = load_telegram_config(os.environ)
    transport = create_live_transport(telegram_config)
    telegram_client = TelegramTestClient(
        config=telegram_config,
        transport=transport,
        live_send_enabled=True,
    )
    print("LIVE transport configured!")
    print()
    
    # Verify connection
    print("Verifying Telegram connection (getMe)...")
    test_result = telegram_client._post("getMe", json_body={})
    
    if not test_result.get("ok"):
        status = test_result.get("status_code", "unknown")
        print(f"[ERROR] Connection failed - HTTP {status}")
        return 1
    
    bot_info = test_result.get("payload", {}).get("result", {})
    print(f"[OK] Connected as @{bot_info.get('username', 'unknown')}")
    print()
    
    # Create integration
    print("Starting V5 listener with CONTINUOUS polling...")
    integration = V5TelegramIntegration(
        config=telegram_config,
        client=telegram_client,
    )
    print("[OK] V5 integration ready")
    print()
    print("=" * 60)
    print()
    print("=== BOT IS RUNNING ===")
    print()
    print("BOT: @NewsagentzohaBot")
    print("CHAT: -5238995962")
    print()
    print("LISTENING FOR COMMANDS (runs indefinitely)...")
    print("Send /make to trigger discovery")
    print()
    print("Press Ctrl+C to stop")
    print()
    print("=" * 60)
    print()
    
    # MAIN POLLING LOOP using run_once
    iteration = 0
    
    try:
        while True:
            iteration += 1
            
            # Run one polling cycle (30 second timeout)
            result = integration.run_once()
            
            handled = result.get("handled", 0)
            updates = result.get("updates", 0)
            
            if handled > 0:
                print(f"[POLL {iteration}] Handled {handled} updates")
            elif iteration % 20 == 0:
                # Heartbeat every 20 polls (approx 10 minutes)
                print(f"[POLL {iteration}] No updates, still listening...")
                
    except KeyboardInterrupt:
        print()
        print("[STOP] Bot stopped by user")
        return 0
    except Exception as e:
        print()
        print(f"[ERROR] {type(e).__name__}: {e}")
        import traceback
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
