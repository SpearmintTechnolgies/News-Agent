"""V5 Telegram Bot - Clean startup with verified connection.

Steps:
1. Verifies Telegram connection
2. Starts V5 listener
3. Waits for /make command

Environment required:
    NEWSAGENT_V2_TELEGRAM_BOT_TOKEN
    NEWSAGENT_V2_TELEGRAM_TEST_CHAT_ID
"""

from __future__ import annotations

import sys
import os

sys.path.insert(0, "src")

from newsagent_v2.telegram.config import load_telegram_config
from newsagent_v2.telegram.client import TelegramTestClient
from newsagent_v2.telegram.live_transport import create_live_transport
from newsagent_v2.telegram.listener_v5 import V5TelegramIntegration


def main() -> int:
    print("=" * 60)
    print("V5 Telegram Bot Starting")
    print("=" * 60)
    
    token = os.environ.get("NEWSAGENT_V2_TELEGRAM_BOT_TOKEN", "").strip()
    chat_id = os.environ.get("NEWSAGENT_V2_TELEGRAM_TEST_CHAT_ID", "").strip()
    
    if not token or not chat_id:
        print("[ERROR] Missing credentials")
        return 1
    
    print("Token: SET")
    print(f"Chat ID: {chat_id}")
    print()
    
    # Setup
    telegram_config = load_telegram_config(os.environ)
    transport = create_live_transport(telegram_config)
    telegram_client = TelegramTestClient(
        config=telegram_config,
        transport=transport,
        live_send_enabled=True,
    )
    print("LIVE transport configured!")
    print()
    
    # Verify connection
    print("Verifying Telegram connection (getMe)...")
    test_result = telegram_client._post("getMe", json_body={})
    
    if not test_result.get("ok"):
        status = test_result.get("status_code", "unknown")
        print(f"[ERROR] Connection failed - HTTP {status}")
        return 1
    
    bot_info = test_result.get("payload", {}).get("result", {})
    print(f"[OK] Connected as @{bot_info.get('username', 'unknown')}")
    print()
    
    # Create integration
    print("Starting V5 listener...")
    integration = V5TelegramIntegration(
        config=telegram_config,
        client=telegram_client,
    )
    print("[OK] V5 listener ready")
    print()
    print("=" * 60)
    print()
    print("=== TELEGRAM CONNECTION VERIFIED ===")
    print()
    print("BOT: @NewsagentzohaBot")
    print("CHAT: -5238995962")
    print()
    print("READY TO RECEIVE /make")
    print()
    print("EOF")
    
    # Start polling (this will block)
    integration.run_once()
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
