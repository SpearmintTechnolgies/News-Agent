# Copy to .env and edit as needed
# cp .env.example .env

GATEWAY_PORT=18789
HOST_UID=1000
HOST_GID=1000

TZ=Asia/Kolkata
SCAN_EVERY_MIN=30
FEED_EVERY_MIN=180
FEED_QUIET_START_HOUR=0
FEED_QUIET_END_HOUR=6
FEED_QUIET_TIMEZONE=Asia/Kolkata

# Google Drive (gog) — required for pipeline uploads
GOG_KEYRING_PASSWORD=sawan
GOG_ACCOUNT=bhardwaj0sawan@gmail.com

# Image generation (Vertex via Bifrost) — override generate.sh defaults
IMAGE_MODEL=vertex/gemini-3.1-flash-image
IMAGE_MODEL_FALLBACK=vertex/gemini-3.1-flash-lite-image

# Bifrost URL is fixed in docker-compose.yml (http://bifrost:8080/v1) — no edit needed.
# Configure LLM providers at http://localhost:8888 after first deploy.
# If port 8888 is already in use locally, set: BIFROST_UI_PORT=8889
