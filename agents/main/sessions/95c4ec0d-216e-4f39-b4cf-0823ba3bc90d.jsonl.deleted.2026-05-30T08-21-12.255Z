11 skills\ndrwxr-xr-x  3 bhard bhard 4096 May 30 06:29 tests\ndrwxr-xr-x  8 bhard bhard 4096 May 29 11:56 tools\ndrwxr-xr-x  6 bhard bhard 4096 May 30 06:29 workers\ndrwxr-xr-x  4 bhard bhard 4096 May 30 06:28 workflows","cwd":"/home/bhard/.openclaw/workspace"},"isError":false,"timestamp":1780127110558}}
