re_state,\n        agent=result.step,\n        error=result.error or \"agent step failed\",\n        detail=result.data,\n        db_path=db_path,\n    )\n\n\ndef workflow_summary(\n    workflow_id: str,\n    db_path: str = backlink_db.DEFAULT_DB_PATH,\n) -> dict[str, Any]:\n    row = load(workflow_id, db_path=db_path)\n    state = parse_state(row.state)\n    return {\n        \"workflow_id\": row.workflow_id,\n        \"state\": row.state,\n        \"current_agent\": row.current_agent,\n        \"last_error\": row.last_error,\n        \"retry_count\": row.retry_count,\n        \"next_action\": get_next_action(state),\n        \"logs\": backlink_db.list_logs(workflow_id, db_path=db_path),\n    }"}],"isError":false,"timestamp":1780130367592},{"role":"user","content":[{"type":"text","text":"Conversation info (untrusted metadata):\n```json\n{\n  \"chat_id\": \"telegram:5691449303\",\n  \"message_id\": \"28\",\n  \"sender_id\": \"5691449303\",\n  \"sender\": \"Sawan bhardwaj\",\n  \"timestamp\": \"Sat 2026-05-30 08:33 UTC\"\n}\n```\n\nSender (untrusted metadata):\n```json\n{\n  \"label\": \"Sawan bhardwaj (5691449303)\",\n  \"id\": \"5691449303\",\n  \"name\": \"Sawan bhardwaj\",\n  \"username\": \"hero_fr_fun\"\n}\n```\n\nrun backlink pipeline"}],"timestamp":1780130376553},{"role":"assistant","content":[{"type":"toolCall","id":"exectsAY89a1kYhvWBoeQ6d1fnVj4gk0gRq6IFkv","name":"exec","arguments":{"command":"ls -la /home/bhard/.openclaw/workspace-orchestrator-backlink"}}],"api":"openai-completions","provider":"local-bifrost","model":"gemini-3.5-flash","usage":{"input":38931,"output":1001,"cacheRead":0,"cacheWrite":0,"totalTokens":39932,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1780130376563,"responseId":"S6IaauK4G9uE694PxKm0EA"},{"role":"toolResult","toolCallId":"exectsAY89a1kYhvWBoeQ6d1fnVj4gk0gRq6IFkv","toolName":"exec","content":[{"type":"text","text":"total 84\ndrwxr-xr-x 12 bhard bhard  4096 May 30 08:32