 backward compat).\nRESULT_FILE=\"/tmp/${PROJECT_SLUG_RESOLVED}-wp-result.txt\"\nRESULT_JSON=\"/tmp/${PROJECT_SLUG_RESOLVED}-wp-result.json\"\n\n[681 more lines in file. Use offset=145 to continue.]"}],"isError":false,"timestamp":1781510234161}}
