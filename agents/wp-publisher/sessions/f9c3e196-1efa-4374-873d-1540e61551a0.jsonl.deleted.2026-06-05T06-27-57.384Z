  \"app_password_ref\": \"credentials/wp/coinography.pass\",\n    \"category_id\": 17,\n    \"default_status\": \"draft\"\n  },\n\n  \"telegram\": {\n    \"account\": \"news\",\n    \"group_id\": \"-1003760909509\",\n    \"group_name\": \"news-agent\",\n    \"card_prefix\": \"[Coinography]\"\n  },\n\n  \"research\": {\n    \"rss_feeds\": [\n      { \"source\": \"CoinDesk\",       \"url\": \"https://www.coindesk.com/arc/outboundfeeds/rss/\" },\n      { \"source\": \"CoinTelegraph\",  \"url\": \"https://cointelegraph.com/rss\" },\n      { \"source\": \"Decrypt\",        \"url\": \"https://decrypt.co/feed\" },\n      { \"source\": \"Google News\",    \"url\": \"https://news.google.com/rss/search?q=cryptocurrency+OR+blockchain+OR+ethereum+OR+solana+OR+altcoin+OR+%22digital+assets%22+OR+XRP+OR+cardano+-dogecoin+-shiba+-pepe+-floki+-bonk+-wif+-memecoin+-%22meme+coin%22&hl=en-US&gl=US&ceid=US:en\" },\n      { \"source\": \"BeInCrypto\",     \"url\": \"https://beincrypto.com/feed/\" },\n      { \"source\": \"The Block\",      \"url\": \"https://www.theblock.co/rss.xml\" },\n      { \"source\": \"CryptoSlate\",    \"url\": \"https://cryptoslate.com/feed/\" },\n      { \"source\": \"CryptoFox\",      \"url\": \"https://cryptofox.news/rss/markets/\" },\n      { \"source\": \"CryptoFox\",      \"url\": \"https://cryptofox.news/rss/regulation/\" }\n    ],\n    \"source_priority_order\": [\"CoinDesk\", \"CoinTelegraph\", \"Decrypt\", \"The Block\", \"BeInCrypto\", \"CryptoSlate\", \"CryptoFox\", \"Google News\"],\n    \"exclude_keywords\": [\"dogecoin\", \"shiba\", \"pepe\", \"floki\", \"bonk\", \"wif\", \"memecoin\", \"meme coin\"],\n    \"exclude_keywords_note\": \"Deprioritize/skip memecoin price pumps unless seriously covered by 2+ priority sources.\",\n    \"headline_scan_target_count\": 10,\n    \"max_age_hours\": 24\n  },\n\n  \"picker\": {\n    \"allowed_categories\": [\n      \"regulation\",\n      \"etf_institutional\",\n      \"hack_exploit\",\n      \"l1_l2_protocol\",\n      \"exchange\",\n      \"stablecoin\",\n      \"adoption_partnership\",\n      \"market_movement\"\n    ],\n    \"diversity_window_hours\": 24\n  },\n\n  \"writer\": {\n    \"template_path\": \"workspace-writer/COINOGRAPHY_TEMPLATE.md\",\n    \"min_body_words\": 1000,\n    \"max_body_words\": 1200,\n    \"sync_max_body_words\": 1300,\n    \"voice_hint\": \"Authoritative, neutral, fact-driven crypto news voice.\"\n  },\n\n  \"creator\": {\n    \"image_style_hint\": \"Reuters-style editorial photograph, natural lighting, professional composition, crypto/finance subject context.\",\n    \"image_aspect\": \"16:9\",\n    \"image_size\": \"1024x576\"\n  },\n\n  \"publisher\": {\n    \"drive_doc_prefix\": \"Crypto News\",\n    \"drive_parent_id\": \"1DiEijL14zMSnuIqycvdoxAIjOgRvxCDx\",\n    \"drive_account\": \"bhardwaj0sawan@gmail.com\"\n  },\n\n  \"authors\": [\n    { \"id\": 3,  \"label\": \"Toby\",  \"name\": \"Toby Rothschild\" },\n    { \"id\": 17, \"label\": \"Ahmed\", \"name\": \"Ahmed Falah\" },\n    { \"id\": 8,  \"label\": \"Golan\", \"name\": \"Golan Malhi\" }\n  ],\n\n  \"state\": {\n    \"recent_topics_file\": \"workspace-orchestrator/state/recent_topics-coinography.json\"\n  }\n}\n"}],"isError":false,"timestamp":1780575905649}}
