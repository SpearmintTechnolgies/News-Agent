   \"name\": \"AIRDROP\"\n    },\n    {\n      \"slug\": \"ai\",\n      \"name\": \"Latest News On Artifical Intelligence (AI)\"\n    },\n    {\n      \"slug\": \"dapp\",\n      \"name\": \"DApps News\"\n    },\n    {\n      \"slug\": \"dao\",\n      \"name\": \"DAO News\"\n    },\n    {\n      \"slug\": \"decentralized\",\n      \"name\": \"Decentralization News\""}],"details":{"status":"completed","exitCode":0,"durationMs":566,"aggregated":"{\n  \"built_at\": \"2026-07-28T12:06:51.414448+00:00\",\n  \"project\": \"coinography\",\n  \"project_name\": \"Coinography\",\n  \"target_count\": 3,\n  \"classify_only\": false,\n  \"recent_window_hours\": 72,\n  \"recent_categories\": [\n    \"DeFi News\",\n    \"Ripple News\",\n    \"Bitcoin News\"\n  ],\n  \"wp_categories\": [\n    {\n      \"slug\": \"bitcoin\",\n      \"name\": \"Bitcoin News\"\n    },\n    {\n      \"slug\": \"ethereum\",\n      \"name\": \"Ethereum News\"\n    },\n    {\n      \"slug\": \"ethlatest-news\",\n      \"name\": \"Ethereum (ETH)\"\n    },\n    {\n      \"slug\": \"xrp\",\n      \"name\": \"XRP News\"\n    },\n    {\n      \"slug\": \"ripple\",\n      \"name\": \"Ripple News\"\n    },\n    {\n      \"slug\": \"policy-and-regulations\",\n      \"name\": \"Policy and Regulations\"\n    },\n    {\n      \"slug\": \"etf\",\n      \"name\": \"ETF News\"\n    },\n    {\n      \"slug\": \"defi\",\n      \"name\": \"DeFi News\"\n    },\n    {\n      \"slug\": \"exploits\",\n      \"name\": \"Exploits News\"\n    },\n    {\n      \"slug\": \"adoption\",\n      \"name\": \"Adoption News\"\n    },\n    {\n      \"slug\": \"cryptomarket-news\",\n      \"name\": \"Market News\"\n    },\n    {\n      \"slug\": \"cryptomarket-analysis\",\n      \"name\": \"Market Analysis\"\n    },\n    {\n      \"slug\": \"altcoin\",\n      \"name\": \"Altcoin News\"\n    },\n    {\n      \"slug\": \"blockchain\",\n      \"name\": \"Blockchain News\"\n    },\n    {\n      \"slug\": \"sec\",\n      \"name\": \"SEC\"\n    }