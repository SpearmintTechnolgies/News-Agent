{"type":"message","id":"188f9e9d","parentId":"f8346622","timestamp":"2026-05-23T10:19:14.783Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_ZtGHy7upFADtWAVRRyJ2WZAJ","name":"read","arguments":{"path":"/home/bhard/.openclaw/workspace-orchestrator/skills/pipeline/handle_card_feedback.py","offset":1,"limit":220}}],"api":"openai-completions","provider":"local-bifrost","model":"gpt-5.4","usage":{"input":644,"output":161,"cacheRead":22016,"cacheWrite":0,"totalTokens":22821,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779531551717,"responseId":"chatcmpl-Didjm63fkGEcDQPwOsE0J0bzcLbEQ"}}
{"type":"message","id":"a3d2c6d8","parentId":"188f9e9d","timestamp":"2026-05-23T10:19:14.799Z","message":{"role":"toolResult","toolCallId":"call_ZtGHy7upFADtWAVRRyJ2WZAJ","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\nhandle_card_feedback.py — Process Telegram RATE/IMAGE feedback for news cards.\n\nUsage:\n    python3 handle_card_feedback.py --payload \"oc_r:20260522-101746:8\" --chat-id \"...\" --user-id \"...\"\n\nAlways exits 0 (fail-open). Prints RATE_RECORDED, RATE_INVALID, ARTICLE_NOT_FOUND, or RATE_MENU_SENT.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nimport urllib.parse\nimport urllib.request\n\n_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nif _SCRIPT_DIR not in sys.path:\n    sys.path.insert(0, _SCRIPT_DIR)\n\nfrom editorial_db import (\n    Article,\n    DEFAULT_DB_PATH,\n    lookup_by_alert_id,\n    lookup_by_message_id,\n    lookup_by_run_id,\n    record_rating,\n)\n\nOPENCLAW_JSON = os.path.expanduser(\"~/.openclaw/openclaw.json\")\n\n_RE_ARTICLE_RATE = re.compile(r\"^oc_r:(.+):(\\d{1,2})$\")\n_RE_IMAGE_RATE = re.compile(r\"^oc_ri:(.+):(\\d{1,2})$\")\n_RE_IMAGE_MENU = re.compile(r\"^oc_ri_menu:(.+)$\")\n_RE_TEXT_RATE = re.compile(r\"^(?:RATE|rate)\\s+(\\d{1,2})\\b\")\n_RE_TEXT_IMAGE = re.compile(r\"^(?:IMAGE|image)\\s+(\\d{1,2})\\b\")\n_RE_ALERT = re.compile(r\"\\bta-([A-Za-z0-9_-]+)\\b\")\n\n\ndef load_bot_token() -> str:\n    try:\n        with open(OPENCLAW_JSON, encoding=\"utf-8\") as f:\n            data = json.load(f)\n        return (data.get(\"channels\") or {}).get(\"telegram\", {}).get(\"botToken\", \"\")\n    except (OSError, json.JSONDecodeError):\n        return \"\"\n\n\ndef telegram_request(token: str, method: str, data: dict | None = None) -> dict:\n    url = f\"https://api.telegram.org/bot{token}/{method}\"\n    encoded = urllib.parse.urlencode(data or {}).encode(\"utf-8\")\n    req = urllib.request.Request(\n        url,\n        data=encoded,\n        headers={\"Content-Type\": \"application/x-www-form-urlencoded\"},\n        method=\"POST\",\n    )\n    with urllib.request.urlopen(req, timeout=60) as resp:\n        raw = resp.read().decode(\"utf-8\")\n    result = json.loads(raw)\n    if not result.get(\"ok\"):\n        desc = result.get(\"description\", \"unknown Telegram error\")\n        raise RuntimeError(desc)\n    return result\n\n\ndef send_message(\n    token: str,\n    chat_id: str,\n    text: str,\n    *,\n    reply_to_message_id: int | None = None,\n    reply_markup: dict | None = None,\n) -> None:\n    payload: dict[str, str] = {\n        \"chat_id\": chat_id,\n        \"text\": text,\n        \"parse_mode\": \"HTML\",\n    }\n    if reply_to_message_id is not None:\n        payload[\"reply_to_message_id\"] = str(reply_to_message_id)\n    if reply_markup:\n        payload[\"reply_markup\"] = json.dumps(reply_markup)\n    telegram_request(token, \"sendMessage\", payload)\n\n\ndef build_image_score_keyboard(run_id: str) -> dict:\n    rows: list[list[dict[str, str]]] = []\n    rows.append(\n        [{\"text\": str(n), \"callback_data\": f\"oc_ri:{run_id}:{n}\"} for n in range(1, 6)]\n    )\n    rows.append(\n        [{\"text\": str(n), \"callback_data\": f\"oc_ri:{run_id}:{n}\"} for n in range(6, 11)]\n    )\n    return {\"inline_keyboard\": rows}\n\n\ndef parse_score(value: str) -> int | None:\n    try:\n        score = int(value)\n    except ValueError:\n        return None\n    if 1 <= score <= 10:\n        return score\n    return None\n\n\ndef resolve_article(\n    *,\n    chat_id: str | None,\n    reply_to_message_id: str | None,\n    run_id: str | None,\n    alert_id: str | None,\n    db_path: str,\n) -> Article | None:\n    if run_id:\n        article = lookup_by_run_id(run_id, db_path)\n        if article:\n            return article\n    if alert_id:\n        article = lookup_by_alert_id(alert_id, db_path)\n        if article:\n            return article\n    if chat_id and reply_to_message_id:\n        try:\n            msg_id = int(reply_to_message_id)\n        except ValueError:\n            return None\n        return lookup_by_message_id(chat_id, msg_id, db_path)\n    return None\n\n\ndef extract_alert_from_text(text: str) -> str | None:\n    match = _RE_ALERT.search(text)\n    return match.group(1) if match else None\n\n\ndef parse_input(\n    payload: str | None, message_text: str | None\n) -> tuple[str, str | None, int | None, str | None] | None:\n    \"\"\"Returns (action, run_id, score, alert_run_id). action: rate_article|rate_image|image_menu|None\"\"\"\n    if payload:\n        payload = payload.strip()\n        menu = _RE_IMAGE_MENU.match(payload)\n        if menu:\n            return (\"image_menu\", menu.group(1).strip(), None, None)\n        art = _RE_ARTICLE_RATE.match(payload)\n        if art:\n            score = parse_score(art.group(2))\n            if score is None:\n                return None\n            return (\"rate_article\", art.group(1).strip(), score, None)\n        img = _RE_IMAGE_RATE.match(payload)\n        if img:\n            score = parse_score(img.group(2))\n            if score is None:\n                return None\n            return (\"rate_image\", img.group(1).strip(), score, None)\n\n    if message_text:\n        text = message_text.strip()\n        img_match = _RE_TEXT_IMAGE.match(text)\n        if img_match:\n            score = parse_score(img_match.group(1))\n            if score is None:\n                return None\n            alert_run = extract_alert_from_text(text)\n            return (\"rate_image\", None, score, alert_run)\n        rate_match = _RE_TEXT_RATE.match(text)\n        if rate_match:\n            score = parse_score(rate_match.group(1))\n            if score is None:\n                return None\n            alert_run = extract_alert_from_text(text)\n            return (\"rate_article\", None, score, alert_run)\n\n    return None\n\n\ndef record_and_confirm(\n    *,\n    article: Article,\n    event_type: str,\n    score: int,\n    user_id: str | None,\n    username: str | None,\n    source: str,\n    raw_payload: str | None,\n    db_path: str,\n    token: str,\n    chat_id: str,\n    reply_to_message_id: int | None,\n) -> str:\n    record_rating(\n        article.id,\n        event_type,\n        score,\n        user_id=user_id,\n        user_username=username,\n        source=source,\n        raw_payload=raw_payload,\n        db_path=db_path,\n    )\n    label = \"article\" if event_type == \"rate_article\" else \"image\"\n    msg = (\n        f\"Rated {label} <b>{score}/10</b> for ALERT: <code>{article.alert_id}</code>\"\n    )\n    if token and chat_id:\n        send_message(\n            token,\n            chat_id,\n            msg,\n            reply_to_message_id=reply_to_message_id,\n        )\n    kind = \"article\" if event_type == \"rate_article\" else \"image\"\n    return f\"RATE_RECORDED: {article.alert_id} {kind}={score}\"\n\n\n[105 more lines in file. Use offset=221 to continue.]"}],"isError":false,"timestamp":1779531554798}}
{"type":"message","id":"8c1fc89d","parentId":"a3d2c6d8","timestamp":"2026-05-23T10:19:16.403Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_XuAIg3nxurFmdhonfDvnRlvH","name":"read","arguments":{"path":"/home/bhard/.openclaw/workspace-orchestrator/skills/pipeline/handle_card_feedback.py","offset":221,"limit":220}}],"api":"openai-completions","provider":"local-bifrost","model":"gpt-5.4","usage":{"input":1850,"output":46,"cacheRead":22528,"cacheWrite":0,"totalTokens":24424,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779531554799,"responseId":"chatcmpl-DidjpEmWiCR75fjSOBrbdIin09J61"}}
{"type":"message","id":"7742495a","parentId":"8c1fc89d","timestamp":"2026-05-23T10:19:16.432Z","message":{"role":"toolResult","toolCallId":"call_XuAIg3nxurFmdhonfDvnRlvH","toolName":"read","content":[{"type":"text","text":"\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Handle Telegram news card RATE/IMAGE feedback\")\n    parser.add_argument(\"--payload\", help=\"Callback data (oc_r:, oc_ri:, oc_ri_menu:)\")\n    parser.add_argument(\"--message-text\", help=\"Plain text command (RATE 8, IMAGE 7)\")\n    parser.add_argument(\"--chat-id\", help=\"Telegram chat id\")\n    parser.add_argument(\"--user-id\", help=\"Telegram user id\")\n    parser.add_argument(\"--username\", default=\"\", help=\"Telegram username\")\n    parser.add_argument(\"--reply-to-message-id\", help=\"Message id being replied to (card lookup)\")\n    parser.add_argument(\"--db-path\", default=DEFAULT_DB_PATH, help=\"SQLite path\")\n    parser.add_argument(\"--no-reply\", action=\"store_true\", help=\"Skip Telegram confirmation message\")\n    args = parser.parse_args()\n\n    if not args.payload and not args.message_text:\n        print(\"RATE_INVALID: no payload or message-text\", file=sys.stderr)\n        return 0\n\n    parsed = parse_input(args.payload, args.message_text)\n    if parsed is None:\n        print(\"RATE_INVALID: unrecognized feedback command\", file=sys.stderr)\n        return 0\n\n    action, run_id, score, alert_run = parsed\n    chat_id = str(args.chat_id or \"\").strip()\n    token = \"\" if args.no_reply else load_bot_token()\n    reply_id: int | None = None\n    if args.reply_to_message_id:\n        try:\n            reply_id = int(args.reply_to_message_id)\n        except ValueError:\n            reply_id = None\n\n    source = \"callback\" if args.payload else \"text\"\n    raw = args.payload or args.message_text\n\n    if action == \"image_menu\":\n        if not run_id:\n            print(\"RATE_INVALID: missing run_id for image menu\", file=sys.stderr)\n            return 0\n        article = lookup_by_run_id(run_id, args.db_path)\n        if not article:\n            print(\"ARTICLE_NOT_FOUND\")\n            if token and chat_id:\n                send_message(\n                    token,\n                    chat_id,\n                    \"No article found for this card.\",\n                    reply_to_message_id=reply_id,\n                )\n            return 0\n        if token and chat_id:\n            send_message(\n                token,\n                chat_id,\n                f\"Rate the <b>image</b> for <code>{article.alert_id}</code>:\",\n                reply_to_message_id=reply_id or article.telegram_message_id,\n                reply_markup=build_image_score_keyboard(article.run_id),\n            )\n        print(f\"RATE_MENU_SENT: {article.alert_id}\")\n        return 0\n\n    assert score is not None\n    article = resolve_article(\n        chat_id=chat_id or None,\n        reply_to_message_id=args.reply_to_message_id,\n        run_id=run_id,\n        alert_id=alert_run,\n        db_path=args.db_path,\n    )\n    if not article:\n        print(\"ARTICLE_NOT_FOUND\")\n        if token and chat_id:\n            send_message(\n                token,\n                chat_id,\n                \"No article found for this message. Reply directly to the news card.\",\n                reply_to_message_id=reply_id,\n            )\n        return 0\n\n    event_type = \"rate_article\" if action == \"rate_article\" else \"rate_image\"\n    try:\n        line = record_and_confirm(\n            article=article,\n            event_type=event_type,\n            score=score,\n            user_id=args.user_id,\n            username=args.username or None,\n            source=source,\n            raw_payload=raw,\n            db_path=args.db_path,\n            token=token,\n            chat_id=chat_id,\n            reply_to_message_id=reply_id,\n        )\n        print(line)\n    except Exception as e:\n        print(f\"RATE_INVALID: {e}\", file=sys.stderr)\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"timestamp":1779531556432}}
