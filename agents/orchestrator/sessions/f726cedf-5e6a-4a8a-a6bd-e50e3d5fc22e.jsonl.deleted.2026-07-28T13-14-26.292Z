ning', drained_at = datetime('now') WHERE id = ?\", (job[\"id\"],))\n    db.commit()\n    print(json.dumps({\n        \"job_id\": job[\"id\"],\n        \"project\": job[\"project\"],\n        \"feed_id\": job[\"feed_id\"],\n        \"candidate_index\": job[\"candidate_index\"],\n        \"selection_file\": job[\"selection_file\"],\n        \"selected_headline\": job[\"selected_headline\"]\n    }))\nelse:\n    print(\"null\")\ndb.close()\nPYEOF"}}],"api":"openai-completions","provider":"bedrock-mantle","model":"minimax.minimax-m2.5","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1785217645090,"responseId":"chatcmpl-f652e2a0-d005-46b7-ac16-bef588846641"}}
