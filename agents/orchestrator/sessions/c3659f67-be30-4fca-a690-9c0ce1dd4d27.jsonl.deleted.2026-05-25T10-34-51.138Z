n   139\t        if not args.no_reply:\n   140\t            token = load_bot_token()\n   141\t            chat_id = str(article.telegram_group or \"\").strip()\n   142\t            if token and chat_id:\n   143\t                send_message(\n   144\t                    token,\n   145\t                    chat_id,\n   146\t                    f\"No changes detected for <code>{article.alert_id}</code>.\\n\\n\"\n   147\t                    \"Try different feedback.\",\n   148\t                )\n   149\t        return 1\n   150"}],"details":{"status":"completed","exitCode":0,"durationMs":18,"aggregated":"100\t    session = pending.session\n   101\t    ok, run_dir = preflight_revision_run_dir(article)\n   102\t    if not ok:\n   103\t        print(f\"EDIT_REVISION_FAILED: {run_dir}\")\n   104\t        return 1\n   105\t\n   106\t    baseline = resolve_current_article_markdown(article, args.db_path) or \"\"\n   107\t    final_md = os.path.join(run_dir, \"article\", \"final.md\")\n   108\t    validated_json = os.path.join(run_dir, \"research\", \"validated.json\")\n   109\t\n   110\t    rc, sync_line = run_cmd(\n   111\t        [sys.executable, SYNC_SCRIPT, \"--run-dir\", run_dir, \"--editorial\"],\n   112\t        timeout=120,\n   113\t    )\n   114\t    if rc != 0 or not sync_line.startswith(\"ARTICLE_SYNCED\"):\n   115\t        print(f\"EDIT_REVISION_FAILED: {sync_line or 'sync failed'}\")\n   116\t        upsert_edit_session(\n   117\t            article.id,\n   118\t            session.user_id,\n   119\t            \"awaiting_feedback\",\n   120\t            prompt_message_id=session.prompt_message_id,\n   121\t            feedback_text=pending.feedback_text,\n   122\t            db_path=args.db_path,\n   123\t        )\n   124\t        return 1\n   125\t\n   126\t    with open(final_md, encoding=\"utf-8\") as f:\n   127\t        revised = f.read()\n   128\t\n   129\t    if normalize_md(revised) == normalize_md(baseline):\n   130\t        print(f\"EDIT_REVISION_UNCH