{"type":"message","id":"cc782be7","parentId":"61d2d920","timestamp":"2026-05-25T09:32:33.937Z","message":{"role":"toolResult","toolCallId":"exec_ts_ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz","toolName":"exec","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\nupload_revised_to_drive.py — Build docx from revised final.md and upload to Google Drive.\n\nUsage:\n    python3 upload_revised_to_drive.py --run-dir /tmp/crypto-run-xxx --alert-id ta-xxx\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\n\n_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nif _SCRIPT_DIR not in sys.path:\n    sys.path.insert(0, _SCRIPT_DIR)\n\nfrom build_and_send_card import extract_drive_url  # noqa: E402\n\nGOG_ACCOUNT = \"bhardwaj0sawan@gmail.com\"\nGOG_ENV = {\"GOG_KEYRING_PASSWORD\": \"sawan\"}\n\n\ndef build_docx(run_dir: str, final_md: str) -> str:\n    image_path = os.path.join(run_dir, \"media\", \"feature.jpg\")\n    with open(final_md, encoding=\"utf-8\") as f:\n        article_md = f.read()\n\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".md\", delete=False, encoding=\"utf-8\") as src:\n        if os.path.isfile(image_path):\n            abs_image = os.path.abspath(image_path)\n            src.write(f\"![Feature Image]({abs_image})\\n\\n\")\n        src.write(article_md)\n        md_path = src.name\n\n    docx_path = os.path.join(tempfile.gettempdir(), f\"crypto-revision-{os.getpid()}.docx\")\n    try:\n        result = subprocess.run(\n            [\"pandoc\", md_path, \"-o\", docx_path, \"--standalone\"],\n            capture_output=True,\n            text=True,\n            timeout=120,\n        )\n        if result.returncode != 0:\n            raise RuntimeError(result.stderr.strip() or \"pandoc failed\")\n        if not os.path.isfile(docx_path) or os.path.getsize(docx_path) == 0:\n            raise RuntimeError(\"docx not created\")\n        return docx_path\n    finally:\n        os.unlink(md_path)\n\n\ndef upload_docx(docx_path: str, alert_id: str) -> str:\n    date_str = datetime.now(timezone.utc).strftime(\"%Y-%m-%d\")\n    name = f\"Crypto News - {alert_id} revision {date_str}\"\n    cmd = [\n        \"gog\",\n        \"drive\",\n        \"upload\",\n        docx_path,\n        \"--name\",\n        name,\n        \"--json\",\n        \"--no-input\",\n        \"--account\",\n        GOG_ACCOUNT,\n    ]\n    result = subprocess.run(\n        cmd,\n        capture_output=True,\n        text=True,\n        timeout=180,\n        env={**os.environ, **GOG_ENV},\n    )\n    if result.returncode != 0:\n        raise RuntimeError((result.stderr or result.stdout or \"gog upload failed\").strip())\n    try:\n        data = json.loads(result.stdout)\n    except json.JSONDecodeError as e:\n        raise RuntimeError(f\"invalid gog JSON: {e}\") from e\n    url = extract_drive_url(data)\n    if not url:\n        raise RuntimeError(\"webViewLink missing from gog response\")\n    return url\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Upload revised article to Google Drive\")\n    parser.add_argument(\"--run-dir\", required=True)\n    parser.add_argument(\"--alert-id\", required=True)\n    parser.add_argument(\"--final-md\", default=\"\", help=\"Override path to final.md\")\n    args = parser.parse_args()\n\n    run_dir = os.path.realpath(args.run_dir)\n    final_md = args.final_md or os.path.join(run_dir, \"article\", \"final.md\")\n    if not os.path.isfile(final_md):\n        print(f\"DRIVE_UPLOAD_FAILED: final.md not found: {final_md}\")\n        return 1\n\n    docx_path = \"\"\n    try:\n        docx_path = build_docx(run_dir, final_md)\n        url = upload_docx(docx_path, args.alert_id.strip())\n        publish_dir = os.path.join(run_dir, \"publish\")\n        os.makedirs(publish_dir, exist_ok=True)\n        out_path = os.path.join(publish_dir, \"google-drive-revision.json\")\n        payload = {\n            \"webViewLink\": url,\n            \"alert_id\": args.alert_id.strip(),\n            \"uploaded_at\": datetime.now(timezone.utc).isoformat(),\n        }\n        with open(out_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(payload, f, indent=2)\n        print(f\"DRIVE_UPLOAD_OK: {url}\")\n        return 0\n    except Exception as e:\n        print(f\"DRIVE_UPLOAD_FAILED: {e}\")\n        return 1\n    finally:\n        if docx_path and os.path.isfile(docx_path):\n            try:\n                os.unlink(docx_path)\n            except OSError:\n                pass\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())"}],"details":{"status":"completed","exitCode":0,"durationMs":15,"aggregated":"#!/usr/bin/env python3\n\"\"\"\nupload_revised_to_drive.py — Build docx from revised final.md and upload to Google Drive.\n\nUsage:\n    python3 upload_revised_to_drive.py --run-dir /tmp/crypto-run-xxx --alert-id ta-xxx\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\n\n_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nif _SCRIPT_DIR not in sys.path:\n    sys.path.insert(0, _SCRIPT_DIR)\n\nfrom build_and_send_card import extract_drive_url  # noqa: E402\n\nGOG_ACCOUNT = \"bhardwaj0sawan@gmail.com\"\nGOG_ENV = {\"GOG_KEYRING_PASSWORD\": \"sawan\"}\n\n\ndef build_docx(run_dir: str, final_md: str) -> str:\n    image_path = os.path.join(run_dir, \"media\", \"feature.jpg\")\n    with open(final_md, encoding=\"utf-8\") as f:\n        article_md = f.read()\n\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".md\", delete=False, encoding=\"utf-8\") as src:\n        if os.path.isfile(image_path):\n            abs_image = os.path.abspath(image_path)\n            src.write(f\"![Feature Image]({abs_image})\\n\\n\")\n        src.write(article_md)\n        md_path = src.name\n\n    docx_path = os.path.join(tempfile.gettempdir(), f\"crypto-revision-{os.getpid()}.docx\")\n    try:\n        result = subprocess.run(\n            [\"pandoc\", md_path, \"-o\", docx_path, \"--standalone\"],\n            capture_output=True,\n            text=True,\n            timeout=120,\n        )\n        if result.returncode != 0:\n            raise RuntimeError(result.stderr.strip() or \"pandoc failed\")\n        if not os.path.isfile(docx_path) or os.path.getsize(docx_path) == 0:\n            raise RuntimeError(\"docx not created\")\n        return docx_path\n    finally:\n        os.unlink(md_path)\n\n\ndef upload_docx(docx_path: str, alert_id: str) -> str:\n    date_str = datetime.now(timezone.utc).strftime(\"%Y-%m-%d\")\n    name = f\"Crypto News - {alert_id} revision {date_str}\"\n    cmd = [\n        \"gog\",\n        \"drive\",\n        \"upload\",\n        docx_path,\n        \"--name\",\n        name,\n        \"--json\",\n        \"--no-input\",\n        \"--account\",\n        GOG_ACCOUNT,\n    ]\n    result = subprocess.run(\n        cmd,\n        capture_output=True,\n        text=True,\n        timeout=180,\n        env={**os.environ, **GOG_ENV},\n    )\n    if result.returncode != 0:\n        raise RuntimeError((result.stderr or result.stdout or \"gog upload failed\").strip())\n    try:\n        data = json.loads(result.stdout)\n    except json.JSONDecodeError as e:\n        raise RuntimeError(f\"invalid gog JSON: {e}\") from e\n    url = extract_drive_url(data)\n    if not url:\n        raise RuntimeError(\"webViewLink missing from gog response\")\n    return url\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Upload revised article to Google Drive\")\n    parser.add_argument(\"--run-dir\", required=True)\n    parser.add_argument(\"--alert-id\", required=True)\n    parser.add_argument(\"--final-md\", default=\"\", help=\"Override path to final.md\")\n    args = parser.parse_args()\n\n    run_dir = os.path.realpath(args.run_dir)\n    final_md = args.final_md or os.path.join(run_dir, \"article\", \"final.md\")\n    if not os.path.isfile(final_md):\n        print(f\"DRIVE_UPLOAD_FAILED: final.md not found: {final_md}\")\n        return 1\n\n    docx_path = \"\"\n    try:\n        docx_path = build_docx(run_dir, final_md)\n        url = upload_docx(docx_path, args.alert_id.strip())\n        publish_dir = os.path.join(run_dir, \"publish\")\n        os.makedirs(publish_dir, exist_ok=True)\n        out_path = os.path.join(publish_dir, \"google-drive-revision.json\")\n        payload = {\n            \"webViewLink\": url,\n            \"alert_id\": args.alert_id.strip(),\n            \"uploaded_at\": datetime.now(timezone.utc).isoformat(),\n        }\n        with open(out_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(payload, f, indent=2)\n        print(f\"DRIVE_UPLOAD_OK: {url}\")\n        return 0\n    except Exception as e:\n        print(f\"DRIVE_UPLOAD_FAILED: {e}\")\n        return 1\n    finally:\n        if docx_path and os.path.isfile(docx_path):\n            try:\n                os.unlink(docx_path)\n            except OSError:\n                pass\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","cwd":"/home/bhard/.openclaw/workspace-orchestrator"},"isError":false,"timestamp":1779701553937}}
