{"type":"message","id":"e9725835","parentId":"a8aabc19","timestamp":"2026-05-25T09:32:26.652Z","message":{"role":"toolResult","toolCallId":"exec_ts_ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz","toolName":"exec","content":[{"type":"text","text":"\"\"\"\nfinalize_editorial_revision.py — Validate writer revision, upload Drive doc, send confirm.\n\nUsage:\n    python3 finalize_editorial_revision.py --alert-id ta-xxx\n    python3 finalize_editorial_revision.py --alert-id ta-xxx --preflight-only\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\n--\nfrom editorial_db import (  # noqa: E402\n    DEFAULT_DB_PATH,\n    get_pending_revision,\n    init_db,\n    lookup_by_alert_id,\n    preflight_revision_run_dir,\n    resolve_current_article_markdown,\n    save_article_version,\n    upsert_edit_session,\n)\nfrom handle_card_feedback import (  # noqa: E402\n--\n    if drive_url:\n        return {\"inline_keyboard\": [[{\"text\": \"Review revised doc\", \"url\": drive_url}]] + rows}\n    return keyboard\n\n\ndef preflight(alert_id: str, db_path: str) -> tuple[bool, str]:\n    article = lookup_by_alert_id(alert_id, db_path)\n    if not article:\n        print(f\"EDIT_REVISION_FAILED: article not found {alert_id}\")\n        return False, \"\"\n    ok, detail = preflight_revision_run_dir(article)\n    if not ok:\n        print(f\"EDIT_REVISION_FAILED: {detail}\")\n        return False, \"\"\n    print(f\"EDIT_REVISION_PREFLIGHT_OK: {alert_id} run_dir={detail}\")\n    return True, detail\n--\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Finalize editorial writer revision\")\n    parser.add_argument(\"--alert-id\", required=True)\n    parser.add_argument(\"--db-path\", default=DEFAULT_DB_PATH)\n    parser.add_argument(\"--preflight-only\", action=\"store_true\")\n    parser.add_argument(\"--no-reply\", action=\"store_true\")\n    args = parser.parse_args()\n\n    alert_id = args.alert_id.strip()\n    if not alert_id.startswith(\"ta-\"):\n        alert_id = f\"ta-{alert_id}\"\n\n    init_db(args.db_path)\n\n    if args.preflight_only:\n        ok, _ = preflight(alert_id, args.db_path)\n        return 0 if ok else 1\n\n    pending = get_pending_revision(alert_id, db_path=args.db_path)\n    if not pending:\n        print(f\"EDIT_REVISION_FAILED: no revision_pending session for {alert_id}\")\n        return 1\n\n    article = pending.article\n    session = pending.session\n    ok, run_dir = preflight_revision_run_dir(article)\n    if not ok:\n        print(f\"EDIT_REVISION_FAILED: {run_dir}\")\n        return 1\n\n    baseline = resolve_current_article_markdown(article, args.db_path) or \"\""}],"details":{"status":"completed","exitCode":0,"durationMs":18,"aggregated":"\"\"\"\nfinalize_editorial_revision.py — Validate writer revision, upload Drive doc, send confirm.\n\nUsage:\n    python3 finalize_editorial_revision.py --alert-id ta-xxx\n    python3 finalize_editorial_revision.py --alert-id ta-xxx --preflight-only\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\n--\nfrom editorial_db import (  # noqa: E402\n    DEFAULT_DB_PATH,\n    get_pending_revision,\n    init_db,\n    lookup_by_alert_id,\n    preflight_revision_run_dir,\n    resolve_current_article_markdown,\n    save_article_version,\n    upsert_edit_session,\n)\nfrom handle_card_feedback import (  # noqa: E402\n--\n    if drive_url:\n        return {\"inline_keyboard\": [[{\"text\": \"Review revised doc\", \"url\": drive_url}]] + rows}\n    return keyboard\n\n\ndef preflight(alert_id: str, db_path: str) -> tuple[bool, str]:\n    article = lookup_by_alert_id(alert_id, db_path)\n    if not article:\n        print(f\"EDIT_REVISION_FAILED: article not found {alert_id}\")\n        return False, \"\"\n    ok, detail = preflight_revision_run_dir(article)\n    if not ok:\n        print(f\"EDIT_REVISION_FAILED: {detail}\")\n        return False, \"\"\n    print(f\"EDIT_REVISION_PREFLIGHT_OK: {alert_id} run_dir={detail}\")\n    return True, detail\n--\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Finalize editorial writer revision\")\n    parser.add_argument(\"--alert-id\", required=True)\n    parser.add_argument(\"--db-path\", default=DEFAULT_DB_PATH)\n    parser.add_argument(\"--preflight-only\", action=\"store_true\")\n    parser.add_argument(\"--no-reply\", action=\"store_true\")\n    args = parser.parse_args()\n\n    alert_id = args.alert_id.strip()\n    if not alert_id.startswith(\"ta-\"):\n        alert_id = f\"ta-{alert_id}\"\n\n    init_db(args.db_path)\n\n    if args.preflight_only:\n        ok, _ = preflight(alert_id, args.db_path)\n        return 0 if ok else 1\n\n    pending = get_pending_revision(alert_id, db_path=args.db_path)\n    if not pending:\n        print(f\"EDIT_REVISION_FAILED: no revision_pending session for {alert_id}\")\n        return 1\n\n    article = pending.article\n    session = pending.session\n    ok, run_dir = preflight_revision_run_dir(article)\n    if not ok:\n        print(f\"EDIT_REVISION_FAILED: {run_dir}\")\n        return 1\n\n    baseline = resolve_current_article_markdown(article, args.db_path) or \"\"","cwd":"/home/bhard/.openclaw/workspace-orchestrator"},"isError":false,"timestamp":1779701546652}}
