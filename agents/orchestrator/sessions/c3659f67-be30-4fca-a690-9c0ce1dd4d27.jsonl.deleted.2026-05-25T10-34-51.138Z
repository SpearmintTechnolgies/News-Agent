chat_id, body, reply_to_message_id=reply_id)\n    return f\"PUBLISH_OK: {article.alert_id}\"\n\n\ndef handle_edit_start(\n    article: Article, user_id: str, username: str | None, db_path: str, token: str, chat_id: str, reply_id: int | None\n) -> str:\n    session = get_edit_session(article.id, user_id, db_path)\n    if session and session.state == \"revision_pending\" and (session.feedback_text or \"\").strip():\n        return f\"EDIT_REVISION_PENDING: {article.alert_id}\"\n\n    ok, detail = preflight_revision_run_dir(article)\n    if not ok:\n        if token and chat_id:\n            send_message(\n                token,\n                chat_id,\n                f\"Cannot edit <code>{article.alert_id}</code>: {detail}\",\n                reply_to_message_id=reply_id,\n            )\n--\n        raw_payload=raw,\n        db_path=db_path,\n    )\n    if token and chat_id:\n        send_message(\n            token,\n            chat_id,\n            f\"Got it — revising <code>{article.alert_id}</code> (may take 1–2 min)…\",\n            reply_to_message_id=reply_id,\n        )\n    return f\"EDIT_REVISION_PENDING: {article.alert_id}\"\n\n\ndef handle_edit_apply(\n    article: Article, user_id: str, source: str, raw: str | None, db_path: str, token: str, chat_id: str, reply_id: int | None\n) -> str:\n    suggested = get_suggested_edit_version(article.id, db_path)\n    if not suggested:\n        if token and chat_id:\n            send_message(token, chat_id, \"No pending edit found.\", reply_to_message_id=reply_id)\n        return \"EDIT_FAILED: no suggested version\"\n--\n            reply_id = None\n    source = \"callback\" if args.payload else \"text\"\n    raw = args.payload or args.message_text\n\n    # Text feedback for editorial revision (before generic command parsing)\n    if args.message_text and not args.payload:\n        text = args.message_text.strip()\n        if _RE_TEXT_REVISION_RETRY.match(text) and args.user_id:\n            pending = get_pending_revision(user_id=args.user_id, db_path=args.db_path)\n            if pending:\n                print(f\"EDIT_REVISION_PENDING: {pending.article.alert_id}\")\n                return 0\n        if parse_input(None, text) is None:\n            feedback_pair = None\n            if reply_id is not None:\n                feedback_pair = get_edit_session_by_prompt(reply_id, args.db_path)\n                if feedback_pair and feedback_pair[0].state not in (\"awaiting_feedback\", \"revision_pending\"):\n                    feedback_pair = None\n            if not feedback_pair and args.user_id:\n                feedback_pair = get_awaiting_feedback_session(args.user_id, args.db_path)\n            if feedback_pair:"}],"details":{"status":"completed","exitCode":0,"durationMs":22,"aggregated":"body += f\"\\n\\n{url}\"\n        send_message(token, chat_id, body, reply_to_message_id=reply_id)\n    return f\"PUBLISH_OK: {article.alert_id}\"\n\n\ndef handle_edit_start(\n    article: Article, user_id: str, username: str | None, db_path: str, token: str, chat_id: str, reply_id: int | None\n) -> str:\n    session = get_edit_session(article.id, user_id, db_path)\n    if session and session.state == \"revision_pending\" and (session.feedback_text or \"\").strip():\n        return f\"EDIT_REVISION_PENDING: {article.alert_id}\"\n\n    ok, detail = preflight_revision_run_dir(article)\n    if not ok:\n        if token and chat_id:\n            send_message(\n                token,\n                chat_id,\n                f\"Cannot edit <code>{article.alert_id}</code>: {detail}\",\n                reply_to_message_id=reply_id,\n            )\n--\n        raw_payload=raw,\n        db_path=db_path,\n    )\n    if token and chat_id:\n        send_message(\n            token,\n            chat_id,\n            f\"Got it — revising <code>{article.alert_id}</code> (may take 1–2 min)…\",\n            reply_to_message_id=reply_id,\n        )\n    return f\"EDIT_REVISION_PENDING: {article.alert_id