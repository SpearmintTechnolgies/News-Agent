" --step wordpress --status succeeded\n\npython3 ~/.openclaw/workspace-orchestrator/skills/pipeline/aggregate_run_tokens.py \\\n  --manifest \"$PIPELINE_MANIFEST\"\n\nTOKENS_JSON=\"$RUN_DIR/publish/tokens.json\"\nTOKENS_ARGS=\"\"\nif [ -f \"$TOKENS_JSON\" ]; then\n  TOKENS_ARGS=$(python3 - <<'PYEOF'\nimport json, os, sys\np = os.path.join(os.environ[\"RUN_DIR\"], \"publish\", \"tokens.json\")\ntry:\n    t = json.load(open(p))\nexcept Exception:\n    sys.exit(0)\nargs = []\nif t.get(\"tokens_in\") is not None:\n    args.append(f\"--tokens-in {int(t[\"tokens_in\"])}\")\nif t.get(\"tokens_out\") is not None:\n    args.append(f\"--tokens-out {int(t[\"tokens_out\"])}\")\nif t.get(\"tokens_total\") is not None:\n    args.append(f\"--tokens-total {int(t[\"tokens_total\"])}\")\nif t.get(\"cost_usd\") is not None:\n    args.append(f\"--cost-usd {float(t[\"cost_usd\"])}\")\nby_model = t.get(\"by_model\")\nif isinstance(by_model, dict) and by_model:\n    # Ensure the JSON string is properly escaped for the shell argument\n    json_string_for_shell = json.dumps(by_model, ensure_ascii=False).replace(\"'\", \"'\\\\''\")\n    args.append(f\"--tokens-by-model '{json_string_for_shell}'\")\nprint(\" \".join(args))\nPYEOF\n)\nfi\npython3 ~/.openclaw/workspace-orchestrator/skills/pipeline/update_pick_status.py \\\n  --pick-id 183 --status published $TOKENS_ARGS\n\nbash ~/.openclaw/workspace-orchestrator/skills/pipeline/switch_iteration.sh --archive 1\n\npython3 ~/.openclaw/workspace-orchestrator/skills/pipeline/build_and_send_card.py \\\n  --manifest \"$PIPELINE_MANIFEST\"\n'"}}],"api":"openai-completions","provider":"local-bifrost","model":"vertex/gemini-2.5-flash","usage":{"input":4817,"output":3229,"cacheRead":32382,"cacheWrite":0,"totalTokens":40428,"cost":{"input":0.00048170000000000005,"output":0.0012916000000000002,"cacheRead":0,"cacheWrite":0,"total":0.0017733000000000002}},"stopReason":"toolUse","timestamp":1782989250916,"responseId":"xEFGarjYPOKF694Pr4GXgQI"}}
