ator/skills/pipeline/build_and_send_card.py \\\n  --manifest \"$PIPELINE_MANIFEST\" --chat-id \"$GROUP_CHAT_ID\"\n\nTOKENS_JSON=\"$RUN_DIR/publish/tokens.json\"\nTOKENS_ARGS=\"\"\nif [ -f \"$TOKENS_JSON\" ]; then\n  TOKENS_ARGS=$(python3 - <<'PYEOF'\nimport json, os, sys\np = os.path.join(os.environ[\"RUN_DIR\"], \"publish\", \"tokens.json\")\ntry:\n    t = json.load(open(p))\nexcept Exception:\n    sys.exit(0)\nargs = []\nif t.get(\"tokens_in\") is not None:\n    args += [\"--tokens-in\", str(int(t[\"tokens_in\"]))]\nif t.get(\"tokens_out\") is not None:\n    args += [\"--tokens-out\", str(int(t[\"tokens_out\"]))]\nif t.get(\"tokens_total\") is not None:\n    args += [\"--tokens-total\", str(int(t[\"tokens_total\"]))]\nif t.get(\"cost_usd\") is not None:\n    args += [\"--cost-usd\", str(float(t[\"cost_usd\"]))]\nby_model = t.get(\"by_model\")\nif isinstance(by_model, dict) and by_model:\n    args += [\"--tokens-by-model\", json.dumps(by_model, ensure_ascii=False)]\nprint(\" \".join(args))\nPYEOF\n)\nfi\npython3 ~/.openclaw/workspace-orchestrator/skills/pipeline/update_pick_status.py \\\n  --pick-id 188 --status published $TOKENS_ARGS\n\nPUBLISHED=1\n\nbash ~/.openclaw/workspace-orchestrator/skills/pipeline/switch_iteration.sh --archive 1\n"}}],"api":"openai-completions","provider":"local-bifrost","model":"vertex/gemini-2.5-flash","usage":{"input":32375,"output":1323,"cacheRead":0,"cacheWrite":0,"totalTokens":33698,"cost":{"input":0.0032375000000000004,"output":0.0005292000000000001,"cacheRead":0,"cacheWrite":0,"total":0.0037667000000000004}},"stopReason":"toolUse","timestamp":1783056324620,"responseId":"xUdHapG_LdKl7PkP8_DAyQ4"}}
