utput=True, text=True)\nif 'PNG' not in r.stdout:\n    print('CHART_INVALID: not a PNG'); sys.exit(1)\nprint(f'CHART_VALID: {size} bytes')\nPYEOF\n  then\n    CHART_OK=1\n    break\n  fi\ndone\nif [ \"$CHART_OK\" -ne 1 ]; then\n  echo '0' > /tmp/expected_placeholders.txt\n  echo 'CHART_FALLBACK: no valid chart after retry'\nfi\n\npython3 - <<'PYEOF'\nimport json\nm = json.load(open('/tmp/pipeline-manifest.json'))\nm['current_step'] = 'generate_chart'\nm['next_step'] = 'generate_image'\nm['steps']['generate_chart'] = {'status': 'succeeded'}\nopen('/tmp/pipeline-manifest.json','w').write(json.dumps(m, indent=2))\nprint('MANIFEST: generate_chart succeeded')\nPYEOF\n\nrm -f ~/.openclaw/agents/creator/sessions/sessions.json\nset +e\nopenclaw agent --agent creator --message \"Generate a feature image for this article. Read /tmp/research.json to find the article title, topic, and primary crypto asset. Use the Scene Formula in your SOUL.md to pick the right human subject and scene, then run the API calls and logo stamp steps exactly as defined in your SOUL.md.\" --deliver > /tmp/creator-output.txt 2>&1\nCREATOR_RC=$?\nset -e\npython3 - <<'PYEOF'\nimport os, subprocess\nimg = '/tmp/crypto-feature.jpg'\nif not os.path.exists(img):\n    print('IMAGE_MISSING: skipping feature image')\n    raise SystemExit(0)\nsize = os.path.getsize(img)\nif size < 10000:\n    print(f'IMAGE_WARN: small file ({size} bytes)')\nr = subprocess.run(['file', img], capture_output=True, text=True)\nif 'JPEG' not in r.stdout and 'image' not in r.stdout.lower():\n    print('IMAGE_WARN: may not be valid JPEG')\nprint(f'IMAGE_VALID: {size} bytes')\nPYEOF\n\npython3 - <<'PYEOF'\nimport json\nm = json.load(open('/tmp/pipeline-manifest.json'))\nm['current_step'] = 'generate_image'\nm['next_step'] = 'publish_drive'\nm['steps']['generate_image'] = {'status': 'succeeded'}\nopen('/tmp/pipeline-manifest.json','w').write(json.dumps(m, indent=2))\nprint('MANIFEST: generate_image succeeded')\nPYEOF\n\nif [ -f /tmp/crypto-feature.jpg ] && [ $(stat -c%s /tmp/crypto-feature.jpg) -gt 10000 ]; then\n  printf '![Feature Image](/tmp/crypto-feature.jpg)\\n\\n' | cat - /tmp/crypto-article.md > /tmp/crypto-with-image.md\nelse\n  cp /tmp/crypto-article.md /tmp/crypto-with-image.md\nfi\n\npython3 - <<'PYEOF'\nimport os, re\nwith open('/tmp/crypto-with-image.md', 'r', encoding='utf-8') as f:\n    content = f.read()\nchart = '/tmp/chart.png'\nif os.path.exists(chart) and os.path.getsize(chart) > 5000:\n    content = content.replace('[CHART_PLACEHOLDER]', '![Price Chart](/tmp/chart.png)')\n    print('[CHART] Replaced placeholders with chart image reference')\nelse:\n    content = content.replace('[CHART_PLACEHOLDER]', '')\n    content = re.sub(r'\\n{3,}', '\\n\\n', content)\n    print('[CHART] No valid chart — stripped placeholders')\nwith open('/tmp/crypto-with-image.md', 'w', encoding='utf-8') as f:\n    f.write(content)\nPYEOF\n\npandoc /tmp/crypto-with-image.md -o /tmp/crypto-article.docx --standalone\n\ntoday=$(date -u +%Y-%m-%d)\nDRIVE_URL=\"\"\nfor attempt in 1 2; do\n  rm -f ~/.openclaw/agents/publisher/sessions/sessions.json\n  set +e\n  openclaw agent --agent publisher --message \"Run this EXACT shell command and return its JSON output: GOG_KEYRING_PASSWORD=\\\"sawan\\\" gog drive upload /tmp/crypto-article.docx --name \\\"Crypto News - ${today}\\\" --json --no-input --account bhardwaj0sawan@gmail.com — Return the webViewLink from the JSON output.\" --deliver > /tmp/publisher-output.txt 2>&1\n  PUB_RC=$?\n  set -e\n  python3 - <<'PYEOF' > /tmp/drive-url.txt\nimport json, re\nfrom pathlib import Path\ntext = Path('/tmp/publisher-output.txt').read_text(encoding='utf-8', errors='ignore')\nurl = ''\n# Try JSON blocks first\nfor m in re.finditer(r'\\{.*?\\}', text, flags=re.S):\n    try:\n        obj = json.loads(m.group(0))\n    except Exception:\n        continue\n    if isinstance(obj, dict):\n        for k in ('webViewLink','webViewUrl','url','link'):\n            v = obj.get(k)\n            if isinstance(v, str) and v.startswith('http'):\n                url = v\n                break\n    if url:\n        break\nif not url:\n    m = re.search(r'https://docs\\.google\\.com/[^\\s)\\]>\"]+', text)\n    if m:\n        url = m.group(0)\nif not url:\n    m = re.search(r'https://drive\\.google\\.com/[^\\s)\\]>\"]+', text)\n    if m:\n        url = m.group(0)\nprint(url)\nPYEOF\n  DRIVE_URL=$(cat /tmp/drive-url.txt)\n  if [ -n \"$DRIVE_URL\" ]; then\n    break\n  fi\n  echo \"PUBLISH_RETRY_${attempt}: no drive URL parsed\"\ndone\n\nif [ -z \"$DRIVE_URL\" ]; then\n  python3 - <<'PYEOF'\nimport json\nm = json.load(open('/tmp/pipeline-manifest.json'))\nm['status'] = 'failed'\nm['errors'].append('Publisher failed: no Google Drive URL parsed')\nopen('/tmp/pipeline-manifest.json','w').write(json.dumps(m, indent=2))\nprint('PIPELINE_FAILED: Publisher failed: no Google Drive URL parsed')\nPYEOF\n  exit 1\nfi\n\npython3 - <<'PYEOF'\nimport json\nfrom pathlib import Path\nm = json.load(open('/tmp/pipeline-manifest.json'))\ndrive_url = Path('/tmp/drive-url.txt').read_text().strip()\nm['status'] = 'awaiting_user_confirmation'\nm['current_step'] = 'await_wp_confirmation'\nm['next_step'] = 'publish_wordpress'\nm['user_input_required'] = True\nm['steps']['publish_drive'] = {'status': 'succeeded'}\nm.setdefault('results', {})['drive_url'] = drive_url\nopen('/tmp/pipeline-manifest.json','w').write(json.dumps(m, indent=2))\nprint('MANIFEST: awaiting user confirmation')\nPYEOF\n\npython3 - <<'PYEOF'\nimport re, json\nfrom pathlib import Path\narticle = Path('/tmp/crypto-article.md').read_text(encoding='utf-8', errors='ignore')\nm = re.search(r'^#\\s+(.+)$', article, flags=re.M)\ntitle = m.group(1).strip() if m else json.load(open('/tmp/research.json')).get('primary_headline', 'Crypto News Article')\nprint('STEP5_TITLE:', title)\nprint('STEP5_URL:', Path('/tmp/drive-url.txt').read_text().strip())\nprint('STEP5_IMAGE:', '/tmp/crypto-feature.jpg')\nPYEOF","name":"set pipef