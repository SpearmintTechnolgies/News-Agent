    MSG=\"Follow your SOUL to cross-reference multiple RSS feeds, find the single biggest news event, and extract deep facts. Return ONLY the aggregated JSON with ALL required fields — no prose outside the JSON block.\"\n  else\n    MSG=\"Return ONLY the JSON. No prose, nothing outside the braces.\"\n  fi\n\n  if openclaw agent --agent researcher --message \"$MSG\" --deliver > /tmp/researcher-raw.txt 2>&1; then\n    if python3 - <<'PY'\nimport json, sys\ntry:\n    text = open('/tmp/researcher-raw.txt').read()\n    data = json.loads(text[text.find('{'):text.rfind('}')+1])\n    required = ['primary_headline','topic_theme','combined_key_facts','source_urls','chart_coin']\n    if any(not data.get(k) for k in required) or len(data.get('combined_key_facts', [])) < 2:\n        sys.exit(1)\n    json.dump(data, open('/tmp/research.json', 'w'), indent=2)\nexcept Exception:\n    sys.exit(1)\nPY\n    then\n      update_manifest \"m['current_step']='research'; m['next_step']='write_article'; m['steps']['research']={'status':'succeeded'}; m['story']['title']=json.load(open('/tmp/research.json')).get('primary_headline','')\"\n      echo 'RESEARCH_VALID'\n      break\n    fi\n  fi\n  if [ $TRY -eq 2 ]; then\n    append_error 'Research failed after 2 attempts'\n    update_manifest \"m['status']='failed'; m['current_step']='research'; m['user_input_required']=False\"\n    echo 'RESEARCH_FAILED: Exhausted retries'\n    exit 1\n  fi\n  TRY=$((TRY+1))\ndone\n\necho 'PROGRESS: research complete; writing article'\n\n# Step 2 — Write Article\nTRY=1\nwhile [ $TRY -le 2 ]; do\n  rm -f ~/.openclaw/agents/writer/sessions/sessions.json || true\n  if [ $TRY -eq 1 ]; then\n    MSG=\"First, run: cat /tmp/research.json — to load your research data. Then read COINOGRAPHY_TEMPLATE.md in your workspace. Write a 1100-1200 word crypto news article. Finish completely with the Sources and Word Count block. Output the article ONLY — no commentary, no status messages.\"\n  else\n    MSG=\"Re-read COINOGRAPH