:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/Western-Union2-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/Western-Union2-gID_7.jpg\" height=\"900\" width=\"1600\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Coachella Uses Google DeepMind AI to Test the Future of Live Entertainment</title>\n  <link>https://decrypt.co/365532/coachella-google-deepmind-ai-test-future-live-entertainment</link>\n  <pubDate>Sun, 26 Apr 2026 19:04:43 +0000</pubDate>\n  \n    <description>Coachella is experimenting with AI-built artist tools, immersive digital worlds, and 3D performance archives that could shape future fan experiences.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=365532</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/04/coachella-2026-ai-cropped-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/04/coachella-2026-ai-cropped-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Your AI Agent Can Now Groan While Untangling Your Vibe Coded Mess</title>\n  <link>https://decrypt.co/365511/ai-agent-groan-endless-toil-vibecoding-suffering</link>\n  <pubDate>Sun, 26 Apr 2026 13:01:02 +0000</pubDate>\n  \n    <description>A new GitHub plugin makes your coding agent emit escalating human moans as it suffers through your spaghetti code.</description>\n  \n  <dc:creator>Jose Antonio Lanz<