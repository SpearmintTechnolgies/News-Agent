:false,\"available\":true},{\"id\":\"mcporter\",\"name\":\"mcporter\",\"description\":\"List, configure, authenticate, call, and inspect MCP servers/tools with mcporter over HTTP or stdio.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/mcporter/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/mcporter\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/mcporter\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/mcporter/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelInvocation\":false,\"available\":true},{\"id\":\"node-connect\",\"name\":\"node-connect\",\"description\":\"Diagnose OpenClaw Android, iOS, or macOS node pairing, QR/setup code, route, auth, and connection failures.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/node-connect/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/node-connect\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/node-connect\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/node-connect/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelInvocation\":false,\"available\":true},{\"id\":\"skill-creator\",\"name\":\"skill-creator\",\"description\":\"Create, edit, improve, tidy, review, audit, or restructure AgentSkills and SKILL.md files.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/skill-creator/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/skill-creator\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/skill-creator\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/skill-creator/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelInvocation\":false,\"available\":true},{\"id\":\"taskflow\",\"name\":\"taskflow\",\"description\":\"Coordinate multi-step detached tasks as one durable TaskFlow job with owner context, state, waits, and child tasks.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelInvocation\":false,\"available\":true},{\"id\":\"taskflow-inbox-triage\",\"name\":\"taskflow-inbox-triage\",\"description\":\"Example TaskFlow pattern for inbox triage, intent routing, waiting on replies, and later summaries.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow-inbox-triage/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow-inbox-triage\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow-inbox-triage\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/taskflow-inbox-triage/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelInvocation\":false,\"available\":true},{\"id\":\"tmux\",\"name\":\"tmux\",\"description\":\"Remote-control tmux sessions for interactive CLIs by sending keystrokes and scraping pane output.\",\"filePath\":\"~/.npm-global/lib/node_modules/openclaw/skills/tmux/SKILL.md\",\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/tmux\",\"source\":\"openclaw-bundled\",\"sourceInfo\":{\"baseDir\":\"~/.npm-global/lib/node_modules/openclaw/skills/tmux\",\"origin\":\"top-level\",\"path\":\"~/.npm-global/lib/node_modules/openclaw/skills/tmux/SKILL.md\",\"scope\":\"project\",\"source\":\"openclaw-bundled\"},\"disableModelIn