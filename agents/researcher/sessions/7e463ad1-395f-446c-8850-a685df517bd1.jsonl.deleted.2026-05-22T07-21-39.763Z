",\\\"__typename\\\":\\\"Menu\\\"},{\\\"id\\\":70,\\\"title\\\":\\\"Editorial Policy\\\",\\\"link\\\":\\\"\\u002Feditorial-policy\\\",\\\"openInNewTab\\\":false,\\\"nofollow\\\":false,\\\"position\\\":1,\\\"category\\\":\\\"footer\\\",\\\"__typename\\\":\\\"Menu\\\"},{\\\"id\\\":71,\\\"title\\\":\\\"Ads Disclosure\\\",\\\"link\\\":\\\"\\u002Fadvertising-disclosure\\\",\\\"openInNewTab\\\":false,\\\"nofollow\\\":false,\\\"position\\\":2,\\\"category\\\":\\\"footer\\\",\\\"__typename\\\":\\\"Menu\\\"},{\\\"id\\\":72,\\\"title\\\":\\\"Financial Risk Disclaimer\\\",\\\"link\\\":\\\"\\u002Ffinancial-risk-disclaimer\\\",\\\"openInNewTab\\\":false,\\\"nofollow\\\":false,\\\"position\\\":3,\\\"category\\\":\\\"footer\\\",\\\"__typename\\\":\\\"Menu\\\"}],\\\"__typename\\\":\\\"Menu_Children\\\"},\\\"__typename\\\":\\\"Menu\\\"}],\\\"__typename\\\":\\\"Menus\\\"}}\",{\"hasNext\":90,\"data\":293},\"{\\\"Articles\\\":{\\\"docs\\\":[{\\\"id\\\":3523,\\\"title\\\":\\\"Blockchain.com confidentially submits IPO filing with SEC\\\",\\\"dek\\\":\\\"The crypto services company began the US IPO process as companies across the digital asset sector weigh public market debuts. \\\",\\\"slug\\\":\\\"blockchaincom-confidentially-submits-ipo-filing-with-sec\\\",\\\"status\\\":\\\"published\\\",\\\"contentType\\\":\\\"editorial\\\",\\\"publishedAt\\\":\\\"2026-05-21T16:30:31.054Z\\\",\\\"updatedAt\\\":\\\"2026-05-21T16:30:36.967Z\\\",\\\"noindex\\\":false,\\\"cover\\\":{\\\"url\\\":\\\"https:\\u002F\\u002Fs3-images.ctmedia.io\\u002Fmedia\\u002Farticle-covers\\u002Fhi-the-revival-of-general-partnerships-in-the-age-of-tokenomics-part-2-2.jpg\\\",\\\"alt\\\":null,\\\"width\\\":1450,\\\"height\\\":966,\\\"__typename\\\":\\\"ArticleCover\\\"},\\\"author\\\":{\\\"id\\\":37,\\\"name\\\":\\\"Nate Kostar\\\",\\\"slug\\\":\\\"nate-kostar\\\",\\\"positionLabel\\\":\\\"Staff Writer\\\",\\\"noindexPosts\\\":false,\\\"cover\\\":{\\\"url\\\":\\\"https:\\u002F\\u002Fs3-images.ctmedia.io\\u002Fmedia\\u002Fauthor-images\\u002Fauthor-3037-nate-kostar.jpg\\\",\\\"alt\\\":\\\"Nate Kostar\\\",\\\"width\\\":600,\\\"height\\\":600,\\\"__typename\\\":\\\"AuthorImage\\\"},\\\"__typename\\\":\\\"Author\\\"},\\\"category\\\":{\\\"id\\\":1,\\\"name\\\":\\\"Latest News\\\",\\\"slug\\\":\\\"latest-news\\\",\\\"folder\\\":\\\"news\\\",\\\"__typename\\\":\\\"Category\\\"},\\\"customAuthor\\\":null,\\\"__typename\\\":\\\"Article\\\",\\\"text\\\":{\\\"root\\\":{\\\"type\\\":\\\"root\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"type\\\":\\\"paragraph\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"Crypto services company Blockchain.com confidentially filed for a US initial public offering (IPO), becoming the latest digital asset player to pursue a public listing as crypto firms return to equity markets.\\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1}],\\\"direction\\\":null,\\\"textStyle\\\":\\\"\\\",\\\"textFormat\\\":0},{\\\"type\\\":\\\"paragraph\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"The company said it submitted a draft S-1 registration statement to the US Securities and Exchange Commission (SEC) related to a proposed offering of Class A ordinary shares. Pricing and the number of shares have not yet been determined.\\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1}],\\\"direction\\\":null,\\\"textStyle\\\":\\\"\\\",\\\"textFormat\\\":0},{\\\"type\\\":\\\"paragraph\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"According to Thursday's announcement, the proposed IPO remains subject to market conditions and SEC review. Confidential S-1 filings allow companies to begin the IPO process and receive regulatory feedback before publicly disclosing financial and offering details.\\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1}],\\\"direction\\\":null,\\\"textStyle\\\":\\\"\\\",\\\"textFormat\\\":0},{\\\"type\\\":\\\"paragraph\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"Founded in 2011, Blockchain.com said it has more than 95 million wallets, over 43 million verified users and has processed more than $1.1 trillion in crypto transactions. The company offers consumer trading and wallet services alongside institutional products.\\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1}],\\\"direction\\\":null,\\\"textStyle\\\":\\\"\\\",\\\"textFormat\\\":0},{\\\"type\\\":\\\"paragraph\\\",\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":1,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"The filing follows several expansion efforts this year, including a deeper \\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1},{\\\"id\\\":\\\"6a0f2908e81d242ab1386528\\\",\\\"type\\\":\\\"link\\\",\\\"fields\\\":{\\\"url\\\":\\\"https:\\u002F\\u002Fcointelegraph.com\\u002Fnews\\u002Fblockchain-com-expands-into-ghana-after-700-trading-growth-in-nigeria\\\",\\\"newTab\\\":false,\\\"linkType\\\":\\\"custom\\\"},\\\"format\\\":\\\"\\\",\\\"indent\\\":0,\\\"version\\\":3,\\\"children\\\":[{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\"push into African markets\\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1}],\\\"direction\\\":null},{\\\"mode\\\":\\\"normal\\\",\\\"text\\\":\\\" and the launch of \\\",\\\"type\\\":\\\"text\\\",\\\"style\\\":\\\"\\\",\\\"detail\\\":0,\\\"format\\\":0,\\\"version\\\":1},{\\\"id\\\":\\\"6a0f28c1e81d242ab1386527\\\",\\\"type\\\":\\\"link\