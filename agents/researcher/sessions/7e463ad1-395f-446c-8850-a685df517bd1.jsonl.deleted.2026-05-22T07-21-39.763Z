1 2.54545L14.7718 12.3636C15.2017 13.0909 14.6643 14 13.8044 14H2.19565C1.33575 14 0.798305 13.0909 1.22826 12.3636L7.03262 2.54545Z\" fill=\"currentColor\"></path><!----></svg> 0.69%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">ADA</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$0.2506</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-green-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><path d=\"M7.03262 2.54545C7.46257 1.81818 8.53745 1.81818 8.96741 2.54545L14.7718 12.3636C15.2017 13.0909 14.6643 14 13.8044 14H2.19565C1.33575 14 0.798305 13.0909 1.22826 12.3636L7.03262 2.54545Z\" fill=\"currentColor\"></path><!----></svg> 0.91%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">BNB</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$657.93</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-green-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><path d=\"M7.03262 2.54545C7.46257 1.81818 8.53745 1.81818 8.96741 2.54545L14.7718 12.3636C15.2017 13.0909 14.6643 14 13.8044 14H2.19565C1.33575 14 0.798305 13.0909 1.22826 12.3636L7.03262 2.54545Z\" fill=\"currentColor\"></path><!----></svg> 0.98%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">ETH</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$2,131</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-green-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><path d=\"M7.03262 2.54545C7.46257 1.81818 8.53745 1.81818 8.96741 2.54545L14.7718 12.3636C15.2017 13.0909 14.6643 14 13.8044 14H2.19565C1.33575 14 0.798305 13.0909 1.22826 12.3636L7.03262 2.54545Z\" fill=\"currentColor\"></path><!----></svg> 0.20%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">SOL</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$86.94</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-green-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><path d=\"M7.03262 2.54545C7.46257 1.81818 8.53745 1.81818 8.96741 2.54545L14.7718 12.3636C15.2017 13.0909 14.6643 14 13.8044 14H2.19565C1.33575 14 0.798305 13.0909 1.22826 12.3636L7.03262 2.54545Z\" fill=\"currentColor\"></path><!----></svg> 0.61%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">HYPE</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$57.38</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-red-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><!----><path d=\"M8.96741 13.4545C8.53745 14.1818 7.46257 14.1818 7.03262 13.4545L1.22826 3.63636C0.798305 2.90909 1.33575 2 2.19565 2H13.8044C14.6643 2 15.2017 2.90909 14.7718 3.63636L8.96741 13.4545Z\" fill=\"currentColor\"></path></svg> 0.35%</span></div><div data-testid=\"rate-ticker\" class=\"inline-flex gap-1 px-2 py-1.5 tabular-nums hover:bg-header-tickers-hover\"><span class=\"text-sm font-semibold text-ct-ds-fg-stronger\" data-testid=\"rate-ticker__title\">XRP</span><span class=\"text-sm text-ct-ds-fg-default\" data-testid=\"rate-ticker__price\">$1.36</span><span class=\"inline-flex items-center font-semibold tracking-tight gap-1 text-sm text-ct-ds-accent-red-default\" data-testid=\"rate-ticker__price-change\"><svg viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"mt-px size-3\"><!----><path d=\"M8.96741 13.4545C8.53745 14.1818 7.46257 14.1818 7.03262 13.4545L1.22826 3.63636C0.798305 2.90909 1.33575 2 2.19565 2H13.8044C14.6643 2 15.2017 2.90909 14.7718 3.63636L8.96741 13.4545Z\" fill=\"currentColor\"></path></svg> 0.60%</span></div><!--]--></div><!--]--></div><!--[--><!--]--></div><div class=\"h-8 grow\"></div></div></div><!--]--><main class=\"flex-1\"><!--[--><div></div><!--[--><!----><div class=\"container pt-4 pb-10 desktop:pt-8\"><div class=\"w-full mb-8\" data-testid=\"ad-banner--leaderboard\"><div class=\"relative w-full overflow-hidden rounded-lg dark:outline dark:outline-ct-ds-border-clear\" style=\"aspect-ratio:1160 / 65;\"><span></span><!----></div></div><div class=\"mx-auto max-w-3xl\"><div data-testid=\"post\"><div class=\"mb-4 text-xs/4.5 font-medium tracking-lean text-pretty wrap-break-word hyphens-auto text-ct-ds-fg-muted tablet:text-sm/5\" data-testid=\"post-byline\"><div class=\"flex items-center desktop:hidden\"><div class=\"pe-3 flex flex-row-reverse items-center pe-1.5\"><span class=\"ct-post-