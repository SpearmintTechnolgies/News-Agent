gin href=\"/_platypus/fonts/2LFQlIVIMAp3yk0sqJXmWuga1luB5bLw_KEGRZfGckk-UNVVGvIexYPCRpnC_q2zwwZVCBp_OyC7BhN3jF8_mmo.woff2\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/pyT0O4E5.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/Tua2YE1Z.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/Cjs_Ytkd.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/lxp7IKpq.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/Da8Nyw9a.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/DqvmlJLU.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/3zDQ3qx9.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/CuV6GGu2.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/VzasF8qp.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/8vuCEND2.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/DQjbv0Ud.js\"><link rel=\"modulepreload\" as=\"script\" crossorigin href=\"/_platypus/ducklings/BoRMsKof.js\"><script type=\"module\" src=\"/_platypus/ducklings/CkEbaxtW.js\" crossorigin></script><link rel=\"dns-prefetch\" href=\"https://servedbyadbutler.com\"><link rel=\"dns-prefetch\" href=\"https://ticker-api.cointelegraph.com\"><link rel=\"prefetch\" as=\"image\" type=\"image/svg+xml\" href=\"/_platypus/ducklings/logo.BYXtOGOo.svg\"><meta name=\"theme-color\" content=\"#FFFFFF\" media=\"(prefers-color-scheme: light)\"><meta name=\"theme-color\" content=\"#04080B\" media=\"(prefers-color-scheme: dark)\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><link rel=\"icon\" type=\"image/png\" sizes=\"96x96\" href=\"/favicon-96x96.png\"><link rel=\"shortcut icon\" href=\"/favicon.ico\"><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\"><link rel=\"manifest\" href=\"/site.webmanifest\"><meta name=\"description\" content=\"Crypto services company Blockchain.com confidentially filed for a US IPO as crypto firms continue exploring public listings despite market conditions.\"><meta property=\"og:title\" content=\"Blockchain.com Moves Toward Public Listing in US\"><meta property=\"og:description\" content=\"Crypto services company Blockchain.com confidentially filed for a US IPO as crypto firms continue exploring public listings despite market conditions.\"><meta property=\"og:site_name\" content=\"Cointelegraph\"><meta property=\"og:url\" content=\"https://cointelegraph.com/news/blockchaincom-confidentially-submits-ipo-filing-with-sec\"><meta property=\"og:locale\" content=\"en\"><meta property=\"og:image\" content=\"https://s3-images.ctmedia.io/media/article-covers/hi-the-revival-of-general-partnerships-in-the-age-of-tokenomics-part-2-2.jpg\"><meta property=\"og:type\" content=\"article\"><meta name=\"twitter:title\" content=\"Blockchain.com Moves Toward Public Listing in US\"><meta name=\"twitter:description\" content=\"Crypto services company Blockchain.com confidentially filed for a US IPO as crypto firms continue exploring public listings despite market conditions.\"><meta name=\"twitter:image\" content=\"https://s3-images.ctmedia.io/media/article-covers/hi-the-revival-of-general-partnerships-in-the-age-of-tokenomics-part-2-2.jpg\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"yandex\" content=\"noindex\"><meta name=\"twitter:site\" content=\"@cointelegraph\"><meta name=\"twitter:creator\" content=\"@cointelegraph\"><link rel=\"alternate\" href=\"https://cointelegraph.com/news/blockchaincom-confidentially-submits-ipo-filing-with-sec\" hreflang=\"en\" data-hid=\"alt-en\"><link rel=\"alternate\" href=\"https://cointelegraph.in/news/blockchaincom-confidentially-submits-ipo-filing-with-sec\" hreflang=\"hi-IN\" data-hid=