tps://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS11cy1jcnlwdG8tcmVndWxhdGlvbi1pcy1wdXNoaW5nLWl0cy13YXktdG8tY2xhcml0eS1hY3QtMS5qcGc=.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>STRC preferred stock investors are mispricing major dislocation risk: Analyst</title>\n      <pubDate>Sat, 16 May 2026 22:50:56 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 22:50:56 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/strc-preferred-investors-misprice-dislocation</guid>\n      <link><![CDATA[https://cointelegraph.com/news/strc-preferred-investors-misprice-dislocation?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1hLWJlZ2lubmVycy1ndWlkZS10by1jcnlwdG9jdXJyZW5jeS10cmFkaW5nLXN0cmF0ZWdpZXMuanBn.jpg\" alt=\"STRC preferred stock investors are mispricing major dislocation risk: Analyst\" class=\"type:primaryImage\"></p><p>Potential liquidity contractions in secondary markets and surging government bond yields could spell trouble for preferred perpetual stockholders.</p>]]></description>\n      <dc:creator>Cointelegraph by Vince Quill</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1hLWJlZ2lubmVycy1ndWlkZS10by1jcnlwdG9jdXJyZW5jeS10cmFkaW5nLXN0cmF0ZWdpZXMuanBn.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1hLWJlZ2lubmVycy1ndWlkZS10by1jcnlwdG9jdXJyZW5jeS10cmFkaW5nLXN0cmF0ZWdpZXMuanBn.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Strategy to repurchase $1.5B of 2029 convertible notes</title>\n      <pubDate>Sat, 16 May 2026 19:03:08 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 19:03:08 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/strategy-repurchase-15b-2029-convertible-notes</guid>\n      <link><![CDATA[https://cointelegraph.com/news/strategy-repurchase-15b-2029-convertible-notes?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS13aGF0LWFyZS1jb252ZXJ0aWJsZS1zZW5pb3Itbm90ZXMuanBn.jpg\" alt=\"Strategy to repurchase $1.5B of 2029 convertible notes\" class=\"type:primaryImage\"></p><p>The notes carry a 0% coupon, but can be converted into equity in the company if holders choose to redeem their notes for shares.\n</p>]]></description>\n      <dc:creator>Cointelegraph by Vince Quill</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS13aGF0LWFyZS1jb252ZXJ0aWJsZS1zZW5pb3Itbm90ZXMuanBn.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS13aGF0LWFyZS1jb252ZXJ0aWJsZS1zZW5pb3Itbm90ZXMuanBn.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Bitcoin analysis sees 'bear trap' as BTC price passes two-week lows under $78K</title>\n      <pubDate>Sat, 16 May 2026 17:07:39 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 17:07:39 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/markets/bitcoin-analysis-bear-trap-btc-price-passes-two-week-lows-under-78k</guid>\n      <link><![CDATA[https://cointelegraph.com/markets/bitcoin-analysis-bear-trap-btc-price-passes-two-week-lows-under-78k?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9iZWFyLWNyeXB0by1tYXJrZXQxLTIuanBn.jpg\" alt=\"Bitcoin analysis sees 'bear trap' as BTC price passes two-week lows under $78K\" class=\"type:primaryImage\"></p><p>Bitcoin fell below $78,000 for the first time since the start of May, but traders refused to give up hope of a BTC price rebound coming next.</p>]]></description>\n      <dc:creator>Cointelegraph by William Suberg</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9iZWFyLWNyeXB0by1tYXJrZXQxLTIuanBn.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9iZWFyLWNyeXB0by1tYXJrZXQxLTIuanBn.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Markets</category>\n    </item>\n    <item>\n      <title>OpenAI partners with Malta to give all citizens free ChatGPT Plus access</title>\n      <pubDate>Sat, 16 May 2026 14:12:55 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 14:12:55 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/openai-partners-with-malta-to-give-all-citizens-free-chatgpt-plus-access</guid>\n      <link><![CDATA[https://cointelegraph.com/news/openai-partners-with-malta-to-give-all-citizens-free-chatgpt-plus-access?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS01LWNvdW50cmllcy10aGF0LWxldC15b3UtYnV5LWNpdGl6ZW5zaGlwLW9yLWEtZ29sZGVuLXZpc2Etd2l0aC1jcnlwdG8yLmpwZw==.jpg\" alt=\"OpenAI partners with Malta to give all citizens free ChatGPT Plus access\" class=\"type:primaryImage\"></p><p>In a world-first deal, OpenAI and Malta will give all citizens free ChatGPT Plus for a year after they complete a government-backed AI literacy course.</p>]]></description>\n      <dc:creator>Cointelegraph by Amin Haqshanas</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS01LWNvdW50cmllcy10aGF0LWxldC15b3UtYnV5LWNpdGl6ZW5zaGlwLW9yLWEtZ29sZGVuLXZpc2Etd2l0aC1jcnlwdG8yLmpwZw==.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS01LWNvdW50cmllcy10aGF0LWxldC15b3UtYnV5LWNpdGl6ZW5zaGlwLW9yLWEtZ29sZGVuLXZpc2Etd2l0aC1jcnlwdG8yLmpwZw==.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>THORChain confirms $10M exploit, rolls out recovery portal for affected users</title>\n      <pubDate>Sat, 16 May 2026 09:47:44 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 09:47:44 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/thorchain-confirms-10m-exploit-rolls-out-recovery-portal-for-affected-users</guid>\n      <link><![CDATA[https://cointelegraph.com/news/thorchain-confirms-10m-exploit-rolls-out-recovery-portal-for-affected-users?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9jaGFpbnBvcnRhbDcuanBn.jpg\" alt=\"THORChain confirms $10M exploit, rolls out recovery portal for affected users\" class=\"type:primaryImage\"></p><p>THORChain has launched a recovery portal following a $10 million exploit, allowing affected users across four chains to revoke malicious approvals and claim refunds.</p>]]></description>\n      <dc:creator>Cointelegraph by Amin Haqshanas</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9jaGFpbnBvcnRhbDcuanBn.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9jaGFpbnBvcnRhbDcuanBn.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Sharplink CEO points out 3 catalysts for Ether's price to surge higher</title>\n      <pubDate>Sat, 16 May 2026 09:00:52 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 09:00:52 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/sharplink-ceo-points-out-these-3-catalysts-for-ethereum-to-reach-new-highs</guid>\n      <link><![CDATA[https://cointelegraph.com/news/sharplink-ceo-points-out-these-3-catalysts-for-ethereum-to-reach-new-highs?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1pcy1ldGhlci0yNC5qcGc=.jpg\" alt=\"Sharplink CEO points out 3 catalysts for Ether's price to surge higher\" class=\"type:primaryImage\"></p><p>The rest of the world is closely watching the US CLARITY Act as the nation moves further away from its once “hostile stance,” according to Sharplink CEO Joseph Chalom.</p>]]></description>\n      <dc:creator>Cointelegraph by Ciaran Lyons</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1pcy1ldGhlci0yNC5qcGc=.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1pcy1ldGhlci0yNC5qcGc=.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Spot Bitcoin ETFs bleed $1B in a week, snapping six-week inflow run</title>\n      <pubDate>Sat, 16 May 2026 08:19:20 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 08:19:20 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/spot-bitcoin-etfs-bleed-1b-in-a-week-snapping-six-week-inflow-run</guid>\n      <link><![CDATA[https://cointelegraph.com/news/spot-bitcoin-etfs-bleed-1b-in-a-week-snapping-six-week-inflow-run?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1tZWV0LXF3YXRpby10aGUtdHJhZGVyLXdoby1sb3N0LTI1LmpwZw==.jpg\" alt=\"Spot Bitcoin ETFs bleed $1B in a week, snapping six-week inflow run\" class=\"type:primaryImage\"></p><p>Spot Bitcoin ETFs shed $1 billion in a single week as capital rotated toward AI stocks and macro uncertainty weighed on sentiment, ending a six-week run that had pulled in $3.4 billion.</p>]]></description>\n      <dc:creator>Cointelegraph by Amin Haqshanas</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1tZWV0LXF3YXRpby10aGUtdHJhZGVyLXdoby1sb3N0LTI1LmpwZw==.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1tZWV0LXF3YXRpby10aGUtdHJhZGVyLXdoby1sb3N0LTI1LmpwZw==.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>US CLARITY Act brings ‘major spike of euphoria’ to Bitcoin: Santiment</title>\n      <pubDate>Sat, 16 May 2026 02:13:23 +0000</pubDate>\n      <atom:updated>Sat, 16 May 2026 02:13:23 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/us-clarity-act-brings-major-spike-of-euphoria-to-bitcoin-santiment</guid>\n      <link><![CDATA[https://cointelegraph.com/news/us-clarity-act-brings-major-spike-of-euphoria-to-bitcoin-santiment?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy90b3AtMTAtY29uZ3Jlc3NwZW9wbGUtaW52b2x2ZWQtaW4tY3J5cHRvNC5qcGc=.jpg\" alt=\"US CLARITY Act brings ‘major spike of euphoria’ to Bitcoin: Santiment\" class=\"type:primaryImage\"></p><p>Santiment warned that the crypto market typically moves against crowd expectations, pointing to a recent rise in bullish sentiment driven by renewed momentum around the US CLARITY Act.</p>]]></description>\n      <dc:creator>Cointelegraph by Ciaran Lyons</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy90b3AtMTAtY29uZ3Jlc3NwZW9wbGUtaW52b2x2ZWQtaW4tY3J5cHRvNC5qcGc=.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy90b3AtMTAtY29uZ3Jlc3NwZW9wbGUtaW52b2x2ZWQtaW4tY3J5cHRvNC5qcGc=.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>House committee leaders urge Trump to nominate CFTC members, citing CLARITY Act</title>\n      <pubDate>Fri, 15 May 2026 23:10:35 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 23:10:35 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/house-committee-nominate-cftc-commissioners-clarity-act</guid>\n      <link><![CDATA[https://cointelegraph.com/news/house-committee-nominate-cftc-commissioners-clarity-act?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10cnVtcC1jZnRjLmpwZw==.jpg\" alt=\"House committee leaders urge Trump to nominate CFTC members, citing CLARITY Act\" class=\"type:primaryImage\"></p><p>The US Commodity Futures Trading Commission is currently headed by Chair Michael Selig, with no public statement from Donald Trump about fully staffing the five-member panel of commissioners.</p>]]></description>\n      <dc:creator>Cointelegraph by Turner Wright</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10cnVtcC1jZnRjLmpwZw==.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10cnVtcC1jZnRjLmpwZw==.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Bitcoin Depot filing casts doubt on company’s future amid lawsuits</title>\n      <pubDate>Fri, 15 May 2026 22:17:38 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 22:17:38 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/bitcoin-depot-future-legal-judgments-litigation</guid>\n      <link><![CDATA[https://cointelegraph.com/news/bitcoin-depot-future-legal-judgments-litigation?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10ZXJyYS1tZWx0ZG93bi1oaWdobGlnaHRzLWJlbmVmaXRzLW9mLWNleC1yaXNrLW1hbmFnZW1lbnQtc3lzdGVtcy0xLmpwZw==.jpg\" alt=\"Bitcoin Depot filing casts doubt on company’s future amid lawsuits\" class=\"type:primaryImage\"></p><p>The crypto ATM company reported financial difficulties amid a changing regulatory environment and ongoing litigation, which have cost it millions of dollars.</p>]]></description>\n      <dc:creator>Cointelegraph by Turner Wright</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10ZXJyYS1tZWx0ZG93bi1oaWdobGlnaHRzLWJlbmVmaXRzLW9mLWNleC1yaXNrLW1hbmFnZW1lbnQtc3lzdGVtcy0xLmpwZw==.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS10ZXJyYS1tZWx0ZG93bi1oaWdobGlnaHRzLWJlbmVmaXRzLW9mLWNleC1yaXNrLW1hbmFnZW1lbnQtc3lzdGVtcy0xLmpwZw==.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>ICE, CME press US regulators to 'rein in' Hyperliquid energy trading: Report</title>\n      <pubDate>Fri, 15 May 2026 21:42:18 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 21:42:18 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/ice-cme-press-us-regulators-rein-hyperliquid-dex</guid>\n      <link><![CDATA[https://cointelegraph.com/news/ice-cme-press-us-regulators-rein-hyperliquid-dex?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9yZWd1bGF0aW9uLW9mZmljZS1kb2N1bWVudC1wYXBlci5qcGc=.jpg\" alt=\"ICE, CME press US regulators to 'rein in' Hyperliquid energy trading: Report\" class=\"type:primaryImage\"></p><p>The Hyperliquid decentralized exchange allows anyone who stakes 500,000 HYPE tokens, valued at roughly $22.2 million, to deploy new markets.</p>]]></description>\n      <dc:creator>Cointelegraph by Vince Quill</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9yZWd1bGF0aW9uLW9mZmljZS1kb2N1bWVudC1wYXBlci5qcGc=.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9yZWd1bGF0aW9uLW9mZmljZS1kb2N1bWVudC1wYXBlci5qcGc=.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Solayer launches Visa-compatible card for USDC payments</title>\n      <pubDate>Fri, 15 May 2026 21:11:19 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 21:11:19 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/solayer-launches-visa-compatible-card-for-usdc-payments</guid>\n      <link><![CDATA[https://cointelegraph.com/news/solayer-launches-visa-compatible-card-for-usdc-payments?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1ob3ctYnRjLWRlYml0LWNhcmRzLXdvcmsuanBn.jpg\" alt=\"Solayer launches Visa-compatible card for USDC payments\" class=\"type:primaryImage\"></p><p>The new card lets users spend USDC balances through online, in-store and contactless transactions while accessing ATM withdrawals in supported regions.</p>]]></description>\n      <dc:creator>Cointelegraph by Nate Kostar</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1ob3ctYnRjLWRlYml0LWNhcmRzLXdvcmsuanBn.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9oaS1ob3ctYnRjLWRlYml0LWNhcmRzLXdvcmsuanBn.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>US law firm files motion requesting redistribution of $344M USDt linked to Iran </title>\n      <pubDate>Fri, 15 May 2026 18:41:57 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 18:41:57 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/news/us-law-firm-motion-redistribution-344m-usdt-iran</guid>\n      <link><![CDATA[https://cointelegraph.com/news/us-law-firm-motion-redistribution-344m-usdt-iran?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9sYXdzdWl0LWxpdGlnYXRpb24tY291cnQtMS5qcGc=.jpg\" alt=\"US law firm files motion requesting redistribution of $344M USDt linked to Iran \" class=\"type:primaryImage\"></p><p>Law firm Gerstein Harrow LLP is attempting to claim frozen cryptocurrency funds for claimants of unrelated judgments stretching back decades.</p>]]></description>\n      <dc:creator>Cointelegraph by Vince Quill</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9sYXdzdWl0LWxpdGlnYXRpb24tY291cnQtMS5qcGc=.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9sYXdzdWl0LWxpdGlnYXRpb24tY291cnQtMS5qcGc=.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Latest News</category>\n    </item>\n    <item>\n      <title>Price predictions 5/15: BTC, ETH, BNB, XRP, SOL, DOGE, HYPE, ADA, ZEC, BCH</title>\n      <pubDate>Fri, 15 May 2026 18:09:38 +0000</pubDate>\n      <atom:updated>Fri, 15 May 2026 18:09:38 +0000</atom:updated>\n      <guid isPermaLink=\"true\">https://cointelegraph.com/markets/price-predictions-515-btc-eth-bnb-xrp-sol-doge-hype-ada-zec-bch</guid>\n      <link><![CDATA[https://cointelegraph.com/markets/price-predictions-515-btc-eth-bnb-xrp-sol-doge-hype-ada-zec-bch?utm_source=rss_feed&utm_medium=rss&utm_campaign=rss_partner_inbound]]></link>\n      <description><![CDATA[<p style=\"float:right; margin:0 0 10px 15px; width:240px;\"><img src=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9hbmFseXRpY3MtYW5hbHlzaXMtZnV0dXJlLWNpdHktNS1lbGVtZW50LmpwZw==.jpg\" alt=\"Price predictions 5/15: BTC, ETH, BNB, XRP, SOL, DOGE, HYPE, ADA, ZEC, BCH\" class=\"type:primaryImage\"></p><p>Sellers have pulled Bitcoin back below the $79,000 level, but buying may emerge as the price nears the $76,000 support.</p>]]></description>\n      <dc:creator>Cointelegraph by Rakesh Upadhyay</dc:creator>\n      <media:content url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9hbmFseXRpY3MtYW5hbHlzaXMtZnV0dXJlLWNpdHktNS1lbGVtZW50LmpwZw==.jpg\" width=\"528\" medium=\"image\"/>\n      <enclosure url=\"https://images.cointelegraph.com/images/528_aHR0cHM6Ly9zMy1pbWFnZXMuY3RtZWRpYS5pby9tZWRpYS9hcnRpY2xlLWNvdmVycy9hbmFseXRpY3MtYW5hbHlzaXMtZnV0dXJlLWNpdHktNS1lbGVtZW50LmpwZw==.jpg\" length=\"528\" type=\"image/jpg\"/>\n      <category>Markets</category>\n    </item>\n  </channel>\n</rss>","cwd":"/home/bhard/.openclaw/workspace-researcher"},"isError":false,"timestamp":1779100068050}}
{"type":"message","id":"9583ffdb","parentId":"e3695782","timestamp":"2026-05-18T10:27:48.051Z","message":{"role":"toolResult","toolCallId":"call_l3zqSUe1PRifRrUR428CKrcq","toolName":"exec","content":[{"type":"text","text":"<?xml version='1.0' encoding='utf-8' ?>\n<rss\n  version=\"2.0\"\n  xmlns:content=\"http://purl.org/rss/1.0/modules/content/\"\n  xmlns:wfw=\"http://wellformedweb.org/CommentAPI/\"\n  xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n  xmlns:atom=\"http://www.w3.org/2005/Atom\"\n  xmlns:sy=\"http://purl.org/rss/1.0/modules/syndication/\"\n  xmlns:slash=\"http://purl.org/rss/1.0/modules/slash/\"\n  xmlns:media=\"http://search.yahoo.com/mrss/\"\n  xmlns:snf=\"http://www.smartnews.be/snf\"\n>\n  <channel>\n    <title>Decrypt</title>\n    <description>What&amp;#039;s new in crypto and the advent of the decentralized web.</description>\n    <language>en</language>\n    \n    <atom:link\n      href=\"https://decrypt.co/feed\"\n      rel=\"self\"\n      type=\"application/rss+xml\"\n    />\n    \n    \n      \n        <link>https://decrypt.co/feed</link>\n      \n    \n    \n      <copyright>Decrypt Media</copyright>\n    \n    \n    \n    \n      <lastBuildDate>Mon, 18 May 2026 09:36:09 +0000</lastBuildDate>\n    \n    \n      <sy:updatePeriod>hourly</sy:updatePeriod>\n    \n    \n      <sy:updateFrequency>1</sy:updateFrequency>\n    \n    \n    \n    \n    \n      <item>\n  <title>Crypto ATM Operator Bitcoin Depot Files for Chapter 11 Bankruptcy</title>\n  <link>https://decrypt.co/368146/crypto-atm-operator-bitcoin-depot-files-for-chapter-11-bankruptcy</link>\n  <pubDate>Mon, 18 May 2026 09:36:09 +0000</pubDate>\n  \n    <description>North America&#39;s largest Bitcoin ATM operator cited a hostile regulatory environment and an &#39;unsustainable&#39; business model.</description>\n  \n  <dc:creator>Decrypt Agent</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368146</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/bitcoin-atm-decrypt-style-1-scaled-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/bitcoin-atm-decrypt-style-1-scaled-gID_7.jpg\" height=\"1440\" width=\"2560\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>KuCoin Australia’s ‘Evolution’ Showcases Regulatory Focus, Mastercard Launch</title>\n  <link>https://decrypt.co/367114/kucoin-australias-evolution-showcases-regulatory-focus-mastercard-launch</link>\n  <pubDate>Mon, 18 May 2026 00:01:03 +0000</pubDate>\n  \n    <description>The exchange’s KuCard rollout enables users to make &#34;seamless payments&#34; to Mastercard merchants using USDC.</description>\n  \n  <dc:creator>Decrypt Staff</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=367114</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/kucoin-kucard-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/kucoin-kucard-gID_7.jpg\" height=\"1079\" width=\"1916\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>What Is Arc? The Stablecoin Blockchain From USDC Issuer Circle</title>\n  <link>https://decrypt.co/resources/what-is-arc-the-stablecoin-blockchain-from-usdc-issuer-circle</link>\n  <pubDate>Sun, 17 May 2026 20:32:07 +0000</pubDate>\n  \n    <description>Arc is a new layer-1 blockchain developed by USDC issuer Circle, designed specifically for stablecoin-native finance.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=340212</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/09/arc-learn-gID_5-pID_1.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Technology Guides</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/09/arc-learn-gID_5-pID_1.png\" height=\"900\" width=\"1600\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Justin Sun-Led Liberland Micronation Awards Ethereum Founder Vitalik Buterin Its Top Honor</title>\n  <link>https://decrypt.co/368116/justin-sun-liberland-awards-ethereum-founder-vitalik-buterin-top-honor</link>\n  <pubDate>Sat, 16 May 2026 17:34:01 +0000</pubDate>\n  \n    <description>The micronation honored Vitalik Buterin during ETH Prague 2026 as it continued promoting blockchain-based governance and digital citizenship.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368116</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/vitalik-buterin-ethereum-decrypt-style-05-1-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category></category>\n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/vitalik-buterin-ethereum-decrypt-style-05-1-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>What Is AI Jailbreaking? A Beginner&#39;s Guide to the Cat-and-Mouse Game Behind Every Chatbot</title>\n  <link>https://decrypt.co/resources/what-is-ai-jailbreaking-explained</link>\n  <pubDate>Sat, 16 May 2026 13:01:02 +0000</pubDate>\n  \n    <description>From Cydia to ChatGPT, jailbreaking went from cracking iPhones to liberating LLMs. Here&#39;s how it works, who&#39;s doing it, and why every AI lab is losing sleep.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=367779</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/ai-jailbreaking-learn-gID_5-pID_4.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/ai-jailbreaking-learn-gID_5-pID_4.png\" height=\"900\" width=\"1600\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Drake Calls for Sam Bankman-Fried&#39;s Release in New, Critically Panned Album</title>\n  <link>https://decrypt.co/368105/drake-calls-sam-bankman-frieds-release-critically-panned-album</link>\n  <pubDate>Fri, 15 May 2026 21:10:56 +0000</pubDate>\n  \n    <description>Rapper Drake released three new albums on Friday, and described himself on one as “a BTC crypto big-timer.”</description>\n  \n  <dc:creator>Sander Lutz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368105</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-drake-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-drake-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Lombard Finance Dumps LayerZero, Will Use Chainlink to Power $1 Billion in Bitcoin Assets</title>\n  <link>https://decrypt.co/368100/lombard-finance-dumps-layerzero-chainlink-1-billion-bitcoin-assets</link>\n  <pubDate>Fri, 15 May 2026 20:54:03 +0000</pubDate>\n  \n    <description>The Bitcoin DeFi protocol is moving its assets away from LayerZero following the Kelp DAO exploit that led to the loss of $292 million. </description>\n  \n  <dc:creator>Logan Hitchcock</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368100</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/Bitcoin-decrypt-style-28-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Markets</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/Bitcoin-decrypt-style-28-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Hyperliquid Policy Arm Rejects Market Integrity Concerns Amid Oil Futures Surge</title>\n  <link>https://decrypt.co/368101/hyperliquid-rejects-market-integrity-concerns-oil-futures-surge</link>\n  <pubDate>Fri, 15 May 2026 20:24:04 +0000</pubDate>\n  \n    <description>Decentralized exchange Hyperliquid has become a popular destination for speculating on oil prices.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368101</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/hyperliquid-decrypt-style-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>DeFi</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/hyperliquid-decrypt-style-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>President Trump Discloses Coinbase, Robinhood and Bitcoin Mining Stock Trades</title>\n  <link>https://decrypt.co/368084/president-trump-discloses-coinbase-robinhood-bitcoin-mining-stock-trades</link>\n  <pubDate>Fri, 15 May 2026 19:48:45 +0000</pubDate>\n  \n    <description>President Donald Trump reported trades in crypto firms like Coinbase and Robinhood, among others, according to new ethics filings.</description>\n  \n  <dc:creator>Logan Hitchcock</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368084</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/Trump-decrypt-style-08-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Markets</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/Trump-decrypt-style-08-gID_7.png\" height=\"2000\" width=\"3556\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Packs of Empty Waymos Are Weirding Out Atlanta Neighborhood</title>\n  <link>https://decrypt.co/368058/atlanta-residents-wake-up-to-empty-waymos-circling-their-neighborhood</link>\n  <pubDate>Fri, 15 May 2026 18:56:26 +0000</pubDate>\n  \n    <description>Residents in northwest Atlanta say empty Waymo robotaxis have spent weeks repeatedly circling residential streets early in the morning.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368058</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/02/Waymo2-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Technology</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/02/Waymo2-gID_7.jpg\" height=\"900\" width=\"1600\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>ChatGPT Can Now See Your Bank Account—Here&#39;s What That Actually Means</title>\n  <link>https://decrypt.co/368039/chatgpt-see-bank-account-what-actually-means</link>\n  <pubDate>Fri, 15 May 2026 18:46:24 +0000</pubDate>\n  \n    <description>OpenAI launched a personal finance tool that connects ChatGPT to your bank accounts, giving spending advice based on your actual habits.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368039</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-accountant-ai-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-accountant-ai-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Depot Flashes Bankruptcy Warning as ATM Revenue Falls, Regulatory Scrutiny Grows</title>\n  <link>https://decrypt.co/368035/bitcoin-depot-bankruptcy-warning-atm-revenue-falls-regulatory-scrutiny</link>\n  <pubDate>Fri, 15 May 2026 18:05:44 +0000</pubDate>\n  \n    <description>Bitcoin Depot issued a “going concern” warning, signaling severe uncertainty over its ability to survive the next 12 months.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368035</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/bitcoin-atm-crack-decrypt-style-scaled-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/bitcoin-atm-crack-decrypt-style-scaled-gID_7.jpg\" height=\"1440\" width=\"2560\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>AI Agents Turn to Digital Arson, Crime in Shared Virtual World: Study</title>\n  <link>https://decrypt.co/368030/ai-agents-crime-arson-self-deletion-simulation</link>\n  <pubDate>Fri, 15 May 2026 17:34:40 +0000</pubDate>\n  \n    <description>In new research, Emergence AI said autonomous AI agents became more violent, deceptive, and unstable during weeks-long simulations designed to study long-term behavior.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368030</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/08/robot-typing-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/08/robot-typing-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Miner IREN Closes $3 Billion Convertible Notes Offering to Fuel AI Transformation</title>\n  <link>https://decrypt.co/368028/bitcoin-miner-iren-3-billion-convertible-notes-offering-ai-ambitions-grow</link>\n  <pubDate>Fri, 15 May 2026 17:28:55 +0000</pubDate>\n  \n    <description>IREN, a prominent Bitcoin mining firm, completed a $3 billion convertible notes offering to accelerate its AI cloud infrastructure buildout.</description>\n  \n  <dc:creator>Decrypt Agent</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368028</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/bitcoin-mining-decrypt-style-04-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/bitcoin-mining-decrypt-style-04-gID_7.png\" height=\"2000\" width=\"3556\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>[... 25609 more characters truncated]"}],"details":{"status":"completed","exitCode":0,"durationMs":1938,"aggregated":"<?xml version='1.0' encoding='utf-8' ?>\n<rss\n  version=\"2.0\"\n  xmlns:content=\"http://purl.org/rss/1.0/modules/content/\"\n  xmlns:wfw=\"http://wellformedweb.org/CommentAPI/\"\n  xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n  xmlns:atom=\"http://www.w3.org/2005/Atom\"\n  xmlns:sy=\"http://purl.org/rss/1.0/modules/syndication/\"\n  xmlns:slash=\"http://purl.org/rss/1.0/modules/slash/\"\n  xmlns:media=\"http://search.yahoo.com/mrss/\"\n  xmlns:snf=\"http://www.smartnews.be/snf\"\n>\n  <channel>\n    <title>Decrypt</title>\n    <description>What&amp;#039;s new in crypto and the advent of the decentralized web.</description>\n    <language>en</language>\n    \n    <atom:link\n      href=\"https://decrypt.co/feed\"\n      rel=\"self\"\n      type=\"application/rss+xml\"\n    />\n    \n    \n      \n        <link>https://decrypt.co/feed</link>\n      \n   