.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/apple-logo-decrypy-style-01-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/apple-logo-decrypy-style-01-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>NFL All Day Stops Issuing NFTs as Dapper Labs Signals Future Plans With League</title>\n  <link>https://decrypt.co/367926/nfl-all-day-stops-issuing-nfts-dapper-labs-future-plans-league</link>\n  <pubDate>Thu, 14 May 2026 21:04:00 +0000</pubDate>\n  \n    <description>Dapper Labs said it has signed a new licensing agreement with the NFL as it discontinues the release of NFTs on its All Day platform.</description>\n  \n  <dc:creator>Logan Hitchcock</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=367926</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-nfl-football-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>NFTs</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/05/decrypt-style-nfl-football-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Firm Strive Unveils Daily Dividend Payments for SATA Preferred Shares</title>\n  <link>https://decrypt.co/367878/bitcoin-firm-strive-daily-dividend-payments-preferred-share</link>\n  <pubDate>Thu, 14 May 2026 19:53:51 +0000</pubDate>\n  \n    <description>Strategy&#39;s Michael Saylor called Strive&#39;s impending shift to daily dividend payments &#34;impressive.&#34;</description>\n