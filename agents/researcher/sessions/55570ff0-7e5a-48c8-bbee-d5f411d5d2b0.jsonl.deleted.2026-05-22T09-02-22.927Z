fy\",\"copilot-proxy\",\"deepgram\",\"deepseek\",\"device-pair\",\"duckduckgo\",\"elevenlabs\",\"exa\",\"fal\",\"firecrawl\",\"fireworks\",\"github-copilot\",\"google\",\"groq\",\"huggingface\",\"kilocode\",\"kimi\",\"litellm\",\"lmstudio\",\"memory-core\",\"microsoft\",\"microsoft-foundry\",\"minimax\",\"mistral\",\"moonshot\",\"nvidia\",\"ollama\",\"openai\",\"opencode\",\"opencode-go\",\"openrouter\",\"perplexity\",\"phone-control\",\"qianfan\",\"qwen\",\"runway\",\"searxng\",\"sglang\",\"stepfun\",\"synthetic\",\"talk-voice\",\"tavily\",\"telegram\",\"tencent\",\"together\",\"venice\",\"vercel-ai-gateway\",\"vllm\",\"volcengine\",\"voyage\",\"vydra\",\"xai\",\"xiaomi\",\"zai\"],\"entries\":[{\"id\":\"acpx\",\"name\":\"ACPX Runtime\",\"version\":\"2026.4.20\",\"description\":\"Embedded ACP runtime backend with plugin-owned session and transport management.\",\"origin\":\"bundled\",\"enabled\":true,\"explicitlyEnabled\":false,\"activated\":true,\"activationSource\":\"default\",\"activationReason\":\"bundled default enablement\",\"status\":\"loaded\",\"format\":\"openclaw\",\"source\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/acpx/index.js\",\"rootDir\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/acpx\"},{\"id\":\"active-memory\",\"name\":\"Active Memory\",\"description\":\"Runs a bounded blocking memory sub-agent before eligible conversational replies and injects relevant memory into prompt context.\",\"origin\":\"bundled\",\"enabled\":false,\"explicitlyEnabled\":false,\"activated\":false,\"activationSource\":\"disabled\",\"activationReason\":\"bundled (disabled by default)\",\"status\":\"disabled\",\"error\":\"bundled (disabled by default)\",\"format\":\"openclaw\",\"source\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/active-memory/index.js\",\"rootDir\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/active-memory\"},{\"id\":\"alibaba\",\"name\":\"Alibaba Model Studio Plugin\",\"version\":\"2026.4.20\",\"description\":\"Bundled Alibaba Model Studio video provider plugin\",\"origin\":\"bundled\",\"enabled\":true,\"explicitlyEnabled\":false,\"activated\":true,\"activationSource\":\"default\",\"activationReason\":\"bundled default enablement\",\"status\":\"loaded\",\"format\":\"openclaw\",\"source\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/alibaba/index.js\",\"rootDir\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/alibaba\",\"videoGenerationProviderIds\":[\"alibaba\"]},{\"id\":\"amazon-bedrock\",\"name\":\"Amazon Bedrock Provider\",\"version\":\"2026.4.20\",\"description\":\"Bundled Amazon Bedrock provider policy plugin\",\"origin\":\"bundled\",\"enabled\":true,\"explicitlyEnabled\":false,\"activated\":true,\"activationSource\":\"default\",\"activationReason\":\"bundled default enablement\",\"status\":\"loaded\",\"format\":\"openclaw\",\"source\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/amazon-bedrock/index.js\",\"rootDir\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/amazon-bedrock\",\"providerIds\":[\"amazon-bedrock\"]},{\"id\":\"amazon-bedrock-mantle\",\"name\":\"Amazon Bedrock Mantle Provider\",\"version\":\"2026.4.20\",\"description\":\"Bundled Amazon Bedrock Mantle (OpenAI-compatible) provider plugin\",\"origin\":\"bundled\",\"enabled\":true,\"explicitlyEnabled\":false,\"activated\":true,\"activationSource\":\"default\",\"activationReason\":\"bundled default enablement\",\"status\":\"loaded\",\"format\":\"openclaw\",\"source\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/amazon-bedrock-mantle/index.js\",\"rootDir\":\"/home/bhard/.npm-global/lib/node_modules/openclaw/dist/extensions/amazon-bedrock-mantle\",\"providerIds\":[\"amazon-bedrock-mantle\"]},{\"id\":\"anthropic\",\"name\":\"Anthropic Provider\",\"version\":\"2026.4.20\",\"description\":\"Bundled Anthropic provider plugin\",\"origin\":\"bundled\",\"