th=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/10/prediction-market-decrypt-style-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Two Men Federally Charged Over AI Deepfake Porn Under the Take It Down Act</title>\n  <link>https://decrypt.co/368797/two-men-federally-charged-ai-deepfake-porn-take-down-act</link>\n  <pubDate>Fri, 22 May 2026 19:52:15 +0000</pubDate>\n  \n    <description>Federal prosecutors charged two men under the 2025 law that criminalizes non-consensual AI-generated intimate imagery.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368797</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/crime_jail-handcuffs-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/crime_jail-handcuffs-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Billionaire Books First SpaceX Mars Mission</title>\n  <link>https://decrypt.co/368804/bitcoin-billionaire-spacex-mars</link>\n  <pubDate>Fri, 22 May 2026 19:23:47 +0000</pubDate>\n  \n    <description>F2Pool co-founder Chun Wang plans a Starship flyby of Mars, before SpaceX attempts to land humans on the surface.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368804</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.