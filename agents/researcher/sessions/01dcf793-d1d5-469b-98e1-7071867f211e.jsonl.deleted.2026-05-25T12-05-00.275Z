 \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Kash Patel-Linked Apparel Store Goes Dark After Pushing Crypto-Stealing Malware</title>\n  <link>https://decrypt.co/368856/kash-patel-apparel-store-goes-dark-crypto-malware</link>\n  <pubDate>Fri, 22 May 2026 21:13:00 +0000</pubDate>\n  \n    <description>User losses weren’t immediately clear.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368856</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/08/fbi-decrypt-style-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Technology</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/08/fbi-decrypt-style-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>SEC Delays Tokenized Stocks Innovation Exemption Amid Concerns: Bloomberg</title>\n  <link>https://decrypt.co/368855/sec-delays-tokenized-stocks-innovation-exemption-amid-concerns-bloomberg</link>\n  <pubDate>Fri, 22 May 2026 20:46:37 +0000</pubDate>\n  \n    <description>The SEC’s expected regulatory framework would have provided clarity for companies looking to tokenize traditional assets like stocks.</description>\n  \n  <dc:creator>Decrypt Agent</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368855</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/SecuritiesExchange_logo-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/SecuritiesExchange_log