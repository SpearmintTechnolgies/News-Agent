\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"99f131d5f5cc\\\",{\\\"children\\\":[\\\"Buterin states that the Ethereum Foundation will pursue \\\\\\\"longevity over breadth,\\\\\\\" reduce ETH sales and narrowly focus on CROPS (censorship resistance, openness, privacy and security).\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"daab6a738700\\\",{\\\"children\\\":[\\\"Buterin's influence in the EF will decrease as the board expands. He framed the EF as \\\\\\\"one node, with a defined purpose,\\\\\\\" not the center of Ethereum.\\\"]}],[\\\"$\\\",\\\"li\\\",\\\"d8728e4ba894\\\",{\\\"children\\\":[\\\"Buterin argued that maximizing throughput/speed is a mistake that leads to mediocrity. Instead, Ethereum must strive to be \\\\\\\"deeply impressive\\\\\\\" in the CROPS dimension.\\\"]}]]}]]}]]}],[\\\"$\\\",\\\"$L7c\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\tlg:hidden\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t[\\u0026_.amt-item]:justify-between\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t-mt-6 mb-3\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\",\\\"children\\\":\\\"$L87\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-ad ad-desktop relative w-[calc(100vw-10px)] md:translate-x-[-50%] md:left-[49.5%] lg:left-[75.5%] xl:left-[49.75%]\\\",\\\"children\\\":[\\\"$\\\",\\\"$L88\\\",null,{\\\"adId\\\":\\\"article_summary\\\",\\\"refId\\\":\\\"article_wtk\\\",\\\"targeting\\\":{\\\"adIndex\\\":\\\"0\\\"}}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$L88\\\",null,{\\\"adId\\\":\\\"native_ad_inbody\\\",\\\"refId\\\":\\\"global_inbody\\\",\\\"targeting\\\":{\\\"pos\\\":\\\"inbody\\\",\\\"adIndex\\\":\\\"1\\\"},\\\"height\\\":\\\"100%\\\",\\\"width\\\":\\\"100%\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"89:T7fb,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"http://sch