{"type":"message","id":"faeafa41","parentId":"6ae74a63","timestamp":"2026-05-04T03:22:05.421Z","message":{"role":"toolResult","toolCallId":"tooluse_xQpWOvu6d410aqJmNG2Jh2","toolName":"exec","content":[{"type":"text","text":"<?xml version='1.0' encoding='utf-8' ?>\n<rss\n  version=\"2.0\"\n  xmlns:content=\"http://purl.org/rss/1.0/modules/content/\"\n  xmlns:wfw=\"http://wellformedweb.org/CommentAPI/\"\n  xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n  xmlns:atom=\"http://www.w3.org/2005/Atom\"\n  xmlns:sy=\"http://purl.org/rss/1.0/modules/syndication/\"\n  xmlns:slash=\"http://purl.org/rss/1.0/modules/slash/\"\n  xmlns:media=\"http://search.yahoo.com/mrss/\"\n  xmlns:snf=\"http://www.smartnews.be/snf\"\n>\n  <channel>\n    <title>Decrypt</title>\n    <description>What&amp;#039;s new in crypto and the advent of the decentralized web.</description>\n    <language>en</language>\n    \n    <atom:link\n      href=\"https://decrypt.co/feed\"\n      rel=\"self\"\n      type=\"application/rss+xml\"\n    />\n    \n    \n      \n        <link>https://decrypt.co/feed</link>\n      \n    \n    \n      <copyright>Decrypt Media</copyright>\n    \n    \n    \n    \n      <lastBuildDate>Sun, 03 May 2026 21:34:40 +0000</lastBuildDate>\n    \n    \n      <sy:updatePeriod>hourly</sy:updatePeriod>\n    \n    \n      <sy:updateFrequency>1</sy:updateFrequency>\n    \n    \n    \n    \n    \n      <item>\n  <title>How Canton Network Lets Institutions Guard Against DeFi Security Risks: Digital Asset CEO</title>\n  <link>https://decrypt.co/366086/how-canton-network-lets-institutions-guard-against-defi-security-risks</link>\n  <pubDate>Sun, 03 May 2026 20:20:00 +0000</pubDate>\n  \n    <description>Because Canton allows participants to implement guardrails, Digital Asset&#39;s Yuval Rooz said institutions can protect against bad actors.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=366086</guid>\n  \n  \n    <encl