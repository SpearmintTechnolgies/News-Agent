pyright>\n    \n    \n    \n    \n      <lastBuildDate>Sun, 24 May 2026 21:01:04 +0000</lastBuildDate>\n    \n    \n      <sy:updatePeriod>hourly</sy:updatePeriod>\n    \n    \n      <sy:updateFrequency>1</sy:updateFrequency>\n    \n    \n    \n    \n    \n      <item>\n  <title>Now You Can Buy Bitcoin, XRP and More in ChatGPT via MoonPay</title>\n  <link>https://decrypt.co/368875/buy-bitcoin-xrp-chatgpt-moonpay</link>\n  <pubDate>Sun, 24 May 2026 21:01:04 +0000</pubDate>\n  \n    <description>MoonPay&#39;s new app lets users buy cryptocurrencies, including Bitcoin and Solana, through ChatGPT just by speaking with the chatbot.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368875</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/04/decrypt-style-moonpay-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category></category>\n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/04/decrypt-style-moonpay-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Strategy Now Holds $65 Billion in Bitcoin—These Are Its Biggest BTC Buys</title>\n  <link>https://decrypt.co/292448/microstrategy-biggest-bitcoin-buys</link>\n  <pubDate>Sun, 24 May 2026 18:53:09 +0000</pubDate>\n  \n    <description>How did Michael Saylor&#39;s firm amass a record stash of Bitcoin? Here&#39;s a look back at how Strategy made such massive gains.</description>\n  \n  <dc:creator>Logan Hitchcock</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=292448</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/michael-saylor-bitcoin-lightning-x-twitter-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category>Business</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/michael-saylor-bitcoin-lightning-x-twitter-gID_7.png\" height=\"2000\" width=\"3556\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>AI Startup Says It Will Pay People $2,000 a Month to Masturbate—Yes, Really</title>\n  <link>https://decrypt.co/368866/ai-startup-pay-people-2000-month-masturbate</link>\n  <pubDate>Sun, 24 May 2026 16:37:04 +0000</pubDate>\n  \n    <description>Joi AI is hiring 10 “masturbation consultants” to test its AI-guided masturbation feature and report how it affects stress, sleep, mood, and confidence.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368866</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/05/ai-decrypt-style-08-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/05/ai-decrypt-style-08-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Firefox&#39;s Big Redesign Gives You a Button to Kill All the AI</title>\n  <link>https://decrypt.co/368867/firefox-redesign-kill-ai-button-project-nova</link>\n  <pubDate>Sat, 23 May 2026 17:01:31 +0000</pubDate>\n  \n    <description>Project Nova is coming later this year with a cleaner look, compact mode, and a toggle to make AI features disappear entirely.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368867</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/07/firefox-decrypt-style-scaled-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/07/firefox-decrypt-style-scaled-gID_7.jpg\" height=\"1440\" width=\"2560\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Dives Below $75K for First Time in a Month as Crypto Liquidations Near $1 Billion</title>\n  <link>https://decrypt.co/368912/bitcoin-drops-75k-crypto-liquidations-near-1-billion</link>\n  <pubDate>Sat, 23 May 2026 16:22:30 +0000</pubDate>\n  \n    <description>Bitcoin touched its lowest price in a month overnight following an awful week for ETFs, which shed over $1.25 billion this week.</description>\n  \n  <dc:creator>Andrew Hayward</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368912</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/02/bitcoin-down-crash-decrypt-style-1-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category></category>\n    \n      <category></category>\n    \n      <category>Markets</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/02/bitcoin-down-crash-decrypt-style-1-gID_7.jpg\" height=\"1080\" width=\"1920\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Argentina Launched an AI to Predict the Future. It Couldn&#39;t Predict a Typo</title>\n  <link>https://decrypt.co/368860/argentina-ai-predict-future</link>\n  <pubDate>Sat, 23 May 2026 15:01:04 +0000</pubDate>\n  \n    <description>Milei&#39;s government unveiled a social digital twin to overhaul public policy—announced via a video full of AI slop, grammatical errors, and a deepfake of a minister.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368860</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/05/javier-milei-decrypt-style-01-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/05/javier-milei-decrypt-style-01-gID_7.jpg\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>3 Wacky Hermes Skills You Should Try</title>\n  <link>https://decrypt.co/368188/3-wacky-hermes-skills-you-should-try</link>\n  <pubDate>Sat, 23 May 2026 13:01:04 +0000</pubDate>\n  \n    <description>A real astrology engine disguised as a fortune teller. A scammer-punishment machine loaded with the Shrek screenplay. A tool that reads any book and maps every idea to your actual life. These are not normal skills.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368188</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/05/ai-decrypt-style-07-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/05/ai-decrypt-style-07-gID_7.png\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Kash Patel-Linked Apparel Store Goes Dark After Pushing Crypto-Stealing Malware</title>\n  <link>https://decrypt.co/368856/kash-patel-apparel-store-goes-dark-crypto-malware</link>\n  <pubDate>Fri, 22 May 2026 21:13:00 +0000</pubDate>\n  \n    <description>User losses weren’t immediately clear.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368856</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/08/fbi-decrypt-style-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Technology</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/08/fbi-decrypt-style-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>SEC Delays Tokenized Stocks Innovation Exemption Amid Concerns: Bloomberg</title>\n  <link>https://decrypt.co/368855/sec-delays-tokenized-stocks-innovation-exemption-amid-concerns-bloomberg</link>\n  <pubDate>Fri, 22 May 2026 20:46:37 +0000</pubDate>\n  \n    <description>The SEC’s expected regulatory framework would have provided clarity for companies looking to tokenize traditional assets like stocks.</description>\n  \n  <dc:creator>Decrypt Agent</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368855</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/SecuritiesExchange_logo-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/SecuritiesExchange_logo-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Microsoft&#39;s Free AI Just Beat OpenAI and Google at Browsing the Web</title>\n  <link>https://decrypt.co/368807/microsoft-fara15-open-source-ai-beats-openai-gemini</link>\n  <pubDate>Fri, 22 May 2026 20:31:03 +0000</pubDate>\n  \n    <description>Fara1.5 is a family of open-weight browser agents from Microsoft Research that outperforms OpenAI&#39;s Operator and Google&#39;s Gemini 2.5 Computer Use on the industry&#39;s toughest live-web benchmark.</description>\n  \n  <dc:creator>Jose Antonio Lanz</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368807</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2026/02/microsoft-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Artificial Intelligence</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2026/02/microsoft-gID_7.jpg\" height=\"900\" width=\"1600\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Kalshi Debuts &#39;Fair Markets&#39; Lobby Group as Congress Opens Insider Trading Probe</title>\n  <link>https://decrypt.co/368803/kalshi-fair-markets-lobby-group-congress-opens-insider-trading-probe</link>\n  <pubDate>Fri, 22 May 2026 20:01:52 +0000</pubDate>\n  \n    <description>Kalshi unveiled Americans for Fair Markets, an advocacy group to help shape policymakers’ perception of prediction markets.</description>\n  \n  <dc:creator>André Beganski</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368803</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/10/prediction-market-decrypt-style-gID_7.jpg@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/10/prediction-market-decrypt-style-gID_7.jpg\" height=\"720\" width=\"1280\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Two Men Federally Charged Over AI Deepfake Porn Under the Take It Down Act</title>\n  <link>https://decrypt.co/368797/two-men-federally-charged-ai-deepfake-porn-take-down-act</link>\n  <pubDate>Fri, 22 May 2026 19:52:15 +0000</pubDate>\n  \n    <description>Federal prosecutors charged two men under the 2025 law that criminalizes non-consensual AI-generated intimate imagery.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368797</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co/wp-content/uploads/2025/06/crime_jail-handcuffs-gID_7.png@png\" length=\"1000000\" type=\"image/png\" />\n  \n  \n    \n      <category>Law and Order</category>\n    \n  \n  \n  \n  \n  \n  \n    \n      <media:thumbnail url=\"https://cdn.decrypt.co/wp-content/uploads/2025/06/crime_jail-handcuffs-gID_7.png\" height=\"1000\" width=\"1778\"/>\n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n\n\n\n</item>\n    \n      <item>\n  <title>Bitcoin Billionaire Books First SpaceX Mars Mission</title>\n  <link>https://decrypt.co/368804/bitcoin-billionaire-spacex-mars</link>\n  <pubDate>Fri, 22 May 2026 19:23:47 +0000</pubDate>\n  \n    <description>F2Pool co-founder Chun Wang plans a Starship flyby of Mars, before SpaceX attempts to land humans on the surface.</description>\n  \n  <dc:creator>Jason Nelson</dc:creator>\n  \n  \n    <guid isPermaLink=\"false\">https://decrypt.co/?p=368804</guid>\n  \n  \n    <enclosure url=\"https://img.decrypt.co/insecure/rs:fill:1024:512:1:0/plain/https://cdn.decrypt.co