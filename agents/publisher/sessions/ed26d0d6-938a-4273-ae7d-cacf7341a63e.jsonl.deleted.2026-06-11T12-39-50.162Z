: \"mci\",\n  \"name\": \"MemeCoinist\",\n  \"description\": \"Memecoin news — launches, pumps, exchange listings, whale moves, Solana/Base meme trends, regulatory takes.\",\n  \"wordpress\": {\n    \"url\": \"https://memecoinist.com\",\n    \"user\": \"kaushikmayank1567@gmail.com\",\n    \"app_password_ref\": \"credentials/wp/memecoinist.pass\",\n    \"default_status\": \"draft\",\n    \"fallback_category_id\": 10,\n    \"picker_category_note\": \"Curated subset of live WP categories passed to the Picker. Run sync_wp_categories.py --slug memecoinist to refresh 'categories' from WP REST API.\",\n    \"picker_category_slugs\": [\n      \"latest-news\",\n      \"breaking-news\",\n      \"market-trends\",\n      \"market-insights\",\n      \"top-performers\",\n      \"trending-memecoins\",\n      \"dogecoin\",\n      \"shiba-inu-coin\",\n      \"pepe\",\n      \"solana-memecoins\",\n      \"ethereum-memecoins\",\n      \"base-memecoins\",\n      \"bnb-memecoins\",\n      \"dogs-memecoins\",\n      \"cats-memecoins\",\n      \"other-animals-memecoins\",\n      \"ai-meme-coins\",\n      \"politifi\",\n      \"trump-memecoins\",\n      \"celebrities-memecoins\",\n      \"sports-based-memecoins\",\n      \"regulatory-and-compliance\",\n      \"memecoin-scams-red-flags\",\n      \"pump-fun\",\n      \"top-memecoin-success-stories\",\n      \"memecoin-roi-tracker\",\n      \"community-buzz\",\n      \"emerging-memecoin-platforms\"\n    ],\n    \"categories\": [\n      {\n        \"id\": 1,\n        \"name\": \"MemeFi\",\n        \"slug\": \"uncategorized\",\n        \"count\": 64\n      },\n      {\n        \"id\": 7,\n        \"name\": \"Analysis\",\n        \"slug\": \"analysis\",\n        \"count\": 100\n      },\n      {\n        \"id\": 8,\n        \"name\": \"Events\",\n        \"slug\": \"events\",\n        \"count\": 8\n      },\n      {\n        \"id\": 10,\n        \"name\": \"Latest News\",\n        \"slug\": \"latest-news\",\n        \"count\": 833\n      },\n   