maintained; survives re-runs of sync_wp_categories.py (which only rewrites `categories`). `latest-news` (id 17) is intentionally excluded here and used only as fallback_category_id.\",\n    \"categories\": [\n      {\n        \"id\": 1,\n        \"name\": \"Stories\",\n        \"slug\": \"stories\",\n        \"count\": 0\n      },\n      {\n        \"id\": 17,\n        \"name\": \"Latest News\",\n        \"slug\": \"latest-news\",\n        \"count\": 1987\n      },\n      {\n        \"id\": 20,\n        \"name\": \"How To\",\n        \"slug\": \"how-to\",\n        \"count\": 102\n      },\n      {\n        \"id\": 22,\n        \"name\": \"Cryptocurrency\",\n        \"slug\": \"cryptocurrency\",\n        \"count\": 241\n      },\n      {\n        \"id\": 32,\n        \"name\": \"Market News\",\n        \"slug\": \"cryptomarket-news\",\n        \"count\": 215\n      },\n      {\n        \"id\": 35,\n        \"name\": \"Business\",\n        \"slug\": \"business\",\n        \"count\": 59\n      },\n      {\n        \"id\": 37,\n        \"name\": \"Cardano (ADA)\",\n        \"slug\": \"analysiscardano-ada\",\n        \"count\": 7\n      },\n      {\n        \"id\": 39,\n        \"name\": \"Analysis\",\n        \"slug\": \"analysis\",\n        \"count\": 60\n      },\n      {\n        \"id\": 42,\n        \"name\": \"Latest Crypto News\",\n        \"slug\": \"cryptolatest-news\",\n        \"count\": 149\n      },\n      {\n        \"id\": 52,\n        \"name\": \"Bitcoin News\",\n        \"slug\": \"bitcoin\",\n        \"count\": 650\n      },\n      {\n        \"id\": 73,\n        \"name\": \"Press Release\",\n        \"slug\": \"press-release\",\n        \"count\": 10\n      },\n      {\n        \"id\": 102,\n        \"name\": \"Ethereum (ETH)\",\n        \"slug\": \"ethlatest-news\",\n        \"count\": 58\n      },\n      {\n        \"id\": 117,\n        \"name\": \"Price Indexes\",\n        \"slug\": \"price-indexes\",\n        \"count\": 6\n      },\n      {\n      