{"type":"message","id":"391dad9c","parentId":"d887f833","timestamp":"2026-06-05T08:12:34.760Z","message":{"role":"toolResult","toolCallId":"read_ts_ZTI0ODMwYTctNWNkNi00MmZlLTk5OGItZWU1MzllNzJiOWMz","toolName":"read","content":[{"type":"text","text":"{\n  \"slug\": \"memecoinist\",\n  \"callback_code\": \"mci\",\n  \"name\": \"MemeCoinist\",\n  \"description\": \"Memecoin news — launches, pumps, exchange listings, whale moves, Solana/Base meme trends, regulatory takes.\",\n\n  \"wordpress\": {\n    \"url\": \"https://memecoinist.com\",\n    \"user\": \"kaushikmayank1567@gmail.com\",\n    \"app_password_ref\": \"credentials/wp/memecoinist.pass\",\n    \"category_id\": 10,\n    \"default_status\": \"draft\",\n    \"site_categories_note\": \"IDs to be back-filled via WP API; informational only — used for future Researcher→WP-category mapping\",\n    \"site_categories\": [\n      \"Latest News\",\n      \"Market Insights\",\n      \"Market Trends\",\n      \"market-data\",\n      \"Memecoin Roi Tracker\",\n      \"Memecoin Scams & Red Flags\",\n      \"MemeFi\",\n      \"Other Animals Memecoins\",\n      \"Pepe & Frog Memecoins\",\n      \"Pepe Frog Memecoins\",\n      \"Politifi\",\n      \"Press Release\",\n      \"Pump fun\",\n      \"Regulatory and Compliance\",\n      \"Shiba Inu Coin\",\n      \"Solana Memecoins\",\n      \"Sports-Based Memecoins\",\n      \"Top Memecoin Success Stories\",\n      \"Top Performers\",\n      \"trending memecoin\"\n    ]\n  },\n\n  \"telegram\": {\n    \"account\": \"news\",\n    \"group_id\": \"-1003760909509\",\n    \"group_name\": \"news-agent\",\n    \"card_prefix\": \"[MemeCoinist]\"\n  },\n\n  \"research\": {\n    \"rss_feeds\": [\n      { \"source\": \"CoinDesk\",      \"url\": \"https://www.coindesk.com/arc/outboundfeeds/rss/\" },\n      { \"source\": \"CoinTelegraph\", \"url\": \"https://cointelegraph.com/rss\" },\n      { \"source\": \"Decrypt\",       \"url\": \"https://decrypt.co/feed\" },\n      { \"source\": \"Google News\",   \"url\": \"https://news.google.com/rss/search?q=memecoin+OR+%22meme+coin%22+OR+dogecoin+OR+shiba+OR+pepe+OR+floki+OR+bonk+OR+wif+OR+dogwifhat&hl=en-US&gl=US&ceid=US:en\" },\n      { \"source\": \"BeInCrypto\",    \"url\": \"https://beincrypto.com/feed/\" },\n      { \"source\": \"The Block\",     \"url\": \"https://www.theblock.co/rss.xml\" },\n      { \"source\": \"CryptoSlate\",   \"url\": \"https://cryptoslate.com/feed/\" },\n      { \"source\": \"CryptoFox\",     \"url\": \"https://cryptofox.news/rss/markets/\" },\n      { \"source\": \"CryptoFox\",     \"url\": \"https://cryptofox.news/rss/regulation/\" }\n    ],\n    \"source_priority_order\": [\n      \"CoinDesk\", \"CoinTelegraph\", \"Decrypt\", \"The Block\",\n      \"BeInCrypto\", \"CryptoSlate\", \"CryptoFox\", \"Google News\"\n    ],\n    \"exclude_keywords\": [\n      \"bitcoin etf\", \"ethereum etf\", \"stablecoin\", \"institutional adoption\",\n      \"sec approval\", \"blackrock\", \"fidelity\", \"l2 upgrade\", \"layer 2 protocol\",\n      \"ethereum upgrade\", \"layer-2\", \"restaking\"\n    ],\n    \"exclude_keywords_note\": \"Deprioritize/skip macro-crypto and ETF stories unless they directly involve a memecoin angle.\",\n    \"headline_scan_target_count\": 10,\n    \"max_age_hours\": 24\n  },\n\n  \"picker\": {\n    \"allowed_categories\": [\n      \"market_movement\",\n      \"exchange\",\n      \"adoption_partnership\",\n      \"hack_exploit\",\n      \"regulation\"\n    ],\n    \"diversity_window_hours\": 24\n  },\n\n  \"writer\": {\n    \"template_path\": \"workspace-mc-writer/MEMECOIN_TEMPLATE.md\",\n    \"min_body_words\": 1000,\n    \"max_body_words\": 1200,\n    \"sync_max_body_words\": 1300,\n    \"voice_hint\": \"Direct, trader-focused, analytical memecoin news. No hype, no fluff.\"\n  },\n\n  \"creator\": {\n    \"image_style_hint\": \"Editorial press photography of a trader reacting to memecoin price action, monitors showing memecoin charts and social feeds, Reuters-style photo