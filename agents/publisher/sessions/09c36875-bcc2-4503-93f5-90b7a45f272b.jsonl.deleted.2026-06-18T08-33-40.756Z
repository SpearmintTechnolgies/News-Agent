ource\": \"CoinTelegraph\",\n        \"url\": \"https://cointelegraph.com/rss\"\n      },\n      {\n        \"source\": \"Decrypt\",\n        \"url\": \"https://decrypt.co/feed\"\n      },\n      {\n        \"source\": \"BeInCrypto\",\n        \"url\": \"https://beincrypto.com/feed/\"\n      },\n      {\n        \"source\": \"The Block\",\n        \"url\": \"https://www.theblock.co/rss.xml\"\n      },\n      {\n        \"source\": \"CryptoSlate\",\n        \"url\": \"https://cryptoslate.com/feed/\"\n      }\n    ],\n    \"source_priority_order\": [\n      \"GN-Memecoin-Broad\",\n      \"GN-Memecoin-Platform\",\n      \"GN-Memecoin-Launch\",\n      \"GN-Memecoin-Tickers\",\n      \"GN-Memecoin-Tickers2\",\n      \"GN-Memecoin-PolitiFi\",\n      \"Bitcoinist-Memecoins\",\n      \"CoinDesk\",\n      \"CoinTelegraph\",\n      \"Decrypt\",\n      \"The Block\",\n      \"BeInCrypto\",\n      \"CryptoSlate\"\n    ],\n    \"exclude_keywords\": [\n      \"bitcoin etf\",\n      \"ethereum etf\",\n      \"stablecoin\",\n      \"institutional adoption\",\n      \"sec approval\",\n      \"blackrock\",\n      \"fidelity\",\n      \"l2 upgrade\",\n      \"layer 2 protocol\",\n      \"ethereum upgrade\",\n      \"layer-2\",\n      \"restaking\",\n      \"fc porto\",\n      \"football\",\n      \"soccer\",\n      \"real madrid\",\n      \"hockey\",\n      \"baseball\",\n      \"obituary\",\n      \"mortuary\",\n      \"puppy\",\n      \"spaghetti\",\n      \"flamenco\",\n      \"commemorative\",\n      \"gold coin\",\n      \"us mint\",\n      \"u.s. mint\",\n      \"24-karat\",\n      \"250th anniversary\",\n      \"country star\"\n    ],\n    \"exclude_keywords_note\": \"Hard-drop macro-crypto/ETF stories and non-crypto false positives (sports/animal/commemorative-coin) before the inclusion gate.\",\n    \"require_keywords\": [\n      \"memecoins?\",\n      \"meme coins?\",\n      \"meme tokens?\",\n      \"meme-coins?\",\n      \"pump\\\\.fun\",\n      \"pumpfun\",\n      \"dogecoin\",\n      \"dogwifhat\",\n      \"fartcoin\",\n      \"spx6900\",\n      \"politifi\",\n      \"gigachad\",\n      \"moodeng\",\n      \"\\\\bwojak\\\\b\",\n      \"trump meme\",\n      \"maga coin\",\n      \"solana meme\",\n      \"base meme\",\n      \"bnb meme\",\n      \"ai meme\",\n      \"\\\\bslerf\\\\b\",\n      \"\\\\bponke\\\\b\",\n      \"\\\\bmichi\\\\b\",\n      \"chill guy\",\n      \"popcat\",\n      \"\\\\bneiro\\\\b\"\n    ],\n    \"require_weak_keywords\": [\n      \"\\\\bpepe\\\\b\",\n      \"\\\\bdoge\\\\b\",\n      \"\\\\bshiba\\\\b\",\n      \"\\\\bshib\\\\b\",\n      \"\\\\bfloki\\\\b\",\n      \"\\\\bbonk\\\\b\",\n      \"\\\\$wif\\\\b\",\n      \"\\\\bbome\\\\b\",\n      \"\\\\bmog\\\\b\"\n    ],\n    \"require_context_keywords\": [\n      \"\\\\bcoin\",\n      \"token\",\n      \"crypto\",\n      \"memecoin\",\n      \"\\\\bprice\\\\b\",\n      \"rally\",\n      \"surge\",\n      \"\\\\bpump\",\n      \"whale\",\n      \"solana\",\n      \"\\\\$\",\n      \"listing\",\n      \"presale\",\n      \"market cap\",\n      \"trading\",\n      \"defi\",\n      \"altcoin\",\n      \"holders\",\n      \"blockchain\",\n      \"\\\\bbtc\\\\b\",\n      \"\\\\beth\\\\b\",\n      \"\\\\bsol\\\\b\",\n      \"binance\",\n      \"coinbase\"\n    ],\n    \"require_keywords_note\": \"Inclusion gate. require_keywords (strong) match anywhere; require_weak_keywords (ambiguous tickers like pepe/doge/bonk) only count when a require_context_keywords term is also present, so non-crypto homonyms (footballer Pepe, hockey player Bonk) are excluded. Tuned empirically against live feeds.\",\n    \"headline_scan_target_count\": 10,\n    \"max_age_hours\": 24\n  },\n  \"picker\": {\n    \"diversity_window_hours\": 72\n  },\n  \"writer\": {\n    \"template_path\": \"workspace-writer/templates/MEMECOIN_TEMPLATE.md\",\n    \"min_body_words\": 1000,\n    \"max_body_words\": 1200,\n    \"sync_max_body_words\": 1300,\n    \"voice_hint\": \"Direct, trader-focused, analytical