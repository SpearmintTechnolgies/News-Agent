s-Based Memecoins\",\n      \"Top Memecoin Success Stories\",\n      \"Top Performers\",\n      \"trending memecoin\"\n    ]\n  },\n\n  \"telegram\": {\n    \"account\": \"news\",\n    \"group_id\": \"-1003760909509\",\n    \"group_name\": \"news-agent\",\n    \"card_prefix\": \"[MemeCoinist]\"\n  },\n\n  \"research\": {\n    \"rss_feeds\": [\n      { \"source\": \"CoinDesk\",      \"url\": \"https://www.coindesk.com/arc/outboundfeeds/rss/\" },\n      { \"source\": \"CoinTelegraph\", \"url\": \"https://cointelegraph.com/rss\" },\n      { \"source\": \"Decrypt\",       \"url\": \"https://decrypt.co/feed\" },\n      { \"source\": \"Google News\",   \"url\": \"https://news.google.com/rss/search?q=memecoin+OR+%22meme+coin%22+OR+dogecoin+OR+shiba+OR+pepe+OR+floki+OR+bonk+OR+wif+OR+dogwifhat&hl=en-US&gl=US&ceid=US:en\" },\n      { \"source\": \"BeInCrypto\",    \"url\": \"https://beincrypto.com/feed/\" },\n      { \"source\": \"The Block\",     \"url\": \"https://www.theblock.co/rss.xml\" },\n      { \"source\": \"CryptoSlate\",   \"url\": \"https://cryptoslate.com/feed/\" },\n      { \"source\": \"CryptoFox\",     \"url\": \"https://cryptofox.news/rss/markets/\" },\n      { \"source\": \"CryptoFox\",     \"url\": \"https://cryptofox.news/rss/regulation/\" }\n    ],\n    \"source_priority_order\": [\n      \"CoinDesk\", \"CoinTelegraph\", \"Decrypt\", \"The Block\",\n      \"BeInCrypto\", \"CryptoSlate\", \"CryptoFox\", \"Google News\"\n    ],\n    \"exclude_keywords\": [\n      \"bitcoin etf\", \"ethereum etf\", \"stablecoin\", \"institutional adoption\",\n      \"sec approval\", \"blackrock\", \"fidelity\", \"l2 upgrade\", \"layer 2 protocol\",\n      \"ethereum upgrade\", \"layer-2\", \"restaking\"\n    ],\n    \"exclude_keywords_note\": \"Deprioritize/skip macro-crypto and ETF stories unless they directly involve a memecoin angle.\",\n    \"headline_scan_target_count\": 10,\n    \"max_age_hours\": 24\n  },\n\n  \"picker\": {\n    \"allowed_categories\": [\n      \"market_movement\",\n      \"exchange\",\n      \"adoption_partnership\",\n      \"hack_exploit\",\n      \"regulation\"\n    ],\n    \"diversity_window_hours\": 24\n  },\n\n  \"writer\": {\n    \"template_path\": \"workspace-mc-writer/MEMECOIN_TEMPLATE.md\",\n    \"min_body_words\": 1000,\n    \"max_body_words\": 1200,\n    \"sync_max_body_words\": 1300,\n    \"voice_hint\": \"Direct, trader-focused, analytical memecoin news. No hype, no fluff.\"\n  },\n\n  \"creator\": {\n    \"image_style_hint\": \"Editorial press photography of a trader reacting to memecoin price action, monitors showing memecoin charts and social feeds, Reuters-style photorealistic, DSLR, candid.\",\n    \"image_aspect\": \"16:9\",\n    \"image_size\": \"1024x576\"\n  },\n\n  \"publisher\": {\n    \"drive_doc_prefix\": \"Memecoin News\",\n    \"drive_parent_id\": \"1DiEijL14zMSnuIqycvdoxAIjOgRvxCDx\",\n    \"drive_account\": \"bhardwaj0sawan@gmail.com\"\n  },\n\n  \"authors\": [\n    { \"id\": 6, \"label\": \"meep AI\", \"name\": \"meep AI\" }\n  ],\n\n  \"state\": {\n    \"recent_topics_file\": \"workspace-orchestrator/state/recent_topics-memecoinist.json\"\n  }\n}\n"}],"isError":false,"timestamp":1780752050435}}
