": \"CryptoFox\",\n        \"url\": \"https://cryptofox.news/rss/regulation/\"\n      }\n    ],\n    \"source_priority_order\": [\n      \"CoinDesk\",\n      \"CoinTelegraph\",\n      \"Decrypt\",\n      \"The Block\",\n      \"BeInCrypto\",\n      \"CryptoSlate\",\n      \"CryptoFox\",\n      \"Google News\"\n    ],\n    \"exclude_keywords\": [\n      \"dogecoin\",\n      \"shiba\",\n      \"pepe\",\n      \"floki\",\n      \"bonk\",\n      \"wif\",\n      \"memecoin\",\n      \"meme coin\"\n    ],\n    \"exclude_keywords_note\": \"Deprioritize/skip memecoin price pumps unless seriously covered by 2+ priority sources.\",\n    \"headline_scan_target_count\": 10,\n    \"max_age_hours\": 24\n  },\n  \"picker\": {\n    \"diversity_window_hours\": 72\n  },\n  \"writer\": {\n    \"template_path\": \"workspace-writer/templates/COINOGRAPHY_TEMPLATE.md\",\n    \"min_body_words\": 1000,\n    \"max_body_words\": 1200,\n    \"sync_max_body_words\": 1300,\n    \"voice_hint\": \"Authoritative, neutral, fact-driven crypto news voice.\"\n  },\n  \"creator\": {\n    \"image_style_hint\": \"Cinematic crypto editorial, photorealistic 3D coin renders or brand logo compositions, dark studio background, dramatic lighting, no humans.\",\n    \"image_aspect\": \"16:9\",\n    \"image_size\": \"1024x576\",\n    \"logo_path\": \"assets/logo.png\"\n  },\n  \"publisher\": {\n    \"drive_doc_prefix\": \"Crypto News\",\n    \"drive_parent_id\": \"1DiEijL14zMSnuIqycvdoxAIjOgRvxCDx\",\n    \"drive_account\": \"bhardwaj0sawan@gmail.com\"\n  },\n  \"authors\": [\n    {\n      \"id\": 3,\n      \"label\": \"Toby\",\n      \"name\": \"Toby Rothschild\"\n    },\n    {\n      \"id\": 17,\n      \"label\": \"Ahmed\",\n      \"name\": \"Ahmed Falah\"\n    },\n    {\n      \"id\": 8,\n      \"label\": \"Golan\",\n      \"name\": \"Golan Malhi\"\n    }\n  ],\n  \"state\": {\n    \"recent_topics_file\": \"workspace-orchestrator/state/recent_topics-coinography.json\"\n  }\n}\n"}],"isError":false,"timestamp":1