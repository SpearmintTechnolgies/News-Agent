  \"count\": 5\n      },\n      {\n        \"id\": 2535,\n        \"name\": \"Ccrypto Adoption\",\n        \"slug\": \"ccrypto-adoption\",\n        \"count\": 0\n      }\n    ]\n  },\n  \"telegram\": {\n    \"account\": \"news\",\n    \"group_id\": \"-1003760909509\",\n    \"group_name\": \"news-agent\",\n    \"card_prefix\": \"[Coinography]\"\n  },\n  \"research\": {\n    \"rss_feeds\": [\n      {\n        \"source\": \"CoinDesk\",\n        \"url\": \"https://www.coindesk.com/arc/outboundfeeds/rss/\"\n      },\n      {\n        \"source\": \"CoinTelegraph\",\n        \"url\": \"https://cointelegraph.com/rss\"\n      },\n      {\n        \"source\": \"Decrypt\",\n        \"url\": \"https://decrypt.co/feed\"\n      },\n      {\n        \"source\": \"Google News\",\n        \"url\": \"https://news.google.com/rss/search?q=cryptocurrency+OR+blockchain+OR+ethereum+OR+solana+OR+altcoin+OR+%22digital+assets%22+OR+XRP+OR+cardano+-dogecoin+-shiba+-pepe+-floki+-bonk+-wif+-memecoin+-%22meme+coin%22&hl=en-US&gl=US&ceid=US:en\"\n      },\n      {\n        \"source\": \"BeInCrypto\",\n        \"url\": \"https://beincrypto.com/feed/\"\n      },\n      {\n        \"source\": \"The Block\",\n        \"url\": \"https://www.theblock.co/rss.xml\"\n      },\n      {\n        \"source\": \"CryptoSlate\",\n        \"url\": \"https://cryptoslate.com/feed/\"\n      },\n      {\n        \"source\": \"CryptoFox\",\n        \"url\": \"https://cryptofox.news/rss/markets/\"\n      },\n      {\n        \"source\": \"CryptoFox\",\n        \"url\": \"https://cryptofox.news/rss/regulation/\"\n      }\n    ],\n    \"source_priority_order\": [\n      \"CoinDesk\",\n      \"CoinTelegraph\",\n      \"Decrypt\",\n      \"The Block\",\n      \"BeInCrypto\",\n      \"CryptoSlate\",\n      \"CryptoFox\",\n      \"Google News\"\n    ],\n    \"exclude_keywords\": [\n      \"dogecoin\",\n      \"shiba\",\n      \"pepe\",\n      \"floki\",\n      \"bonk\",\n      \"wif\",\n      \"memecoin\",\n      \"meme coin